string automation.resolveManualReviewCode(string codeKey)
{
	// =========================================================================
	// _util_resolveManualReviewCode   (VERSION: v6-product-deal)
	//
	// Canonical registry of Manual Review codes (spec 06/08 + plan Part B). Returns
	// the code as a bracketed token "[code]" intended to be the LEADING token of a
	// createAuxTask note. createAuxTask already dedups a reused Manual Review on its
	// leading [token] (see createAuxTask append-issue logic), so routing every
	// review reason through this registry gives idempotent, greppable review notes
	// with NO change to createAuxTask's signature.
	//
	// Prefer the createManualReview() wrapper for the common path; call this
	// directly only when you need the raw "[code]" string.
	//
	// Unknown keys are never silently swallowed: they are logged and returned as a
	// normalised bracketed literal so the reason still surfaces on the task.
	// =========================================================================
	key = ifnull(codeKey, "").toString().trim().toLowerCase();
	key = key.replaceAll("[^a-z0-9_]+", "_").replaceAll("^_+", "").replaceAll("_+$", "");
	if(key == "") { return "[manual_review]"; }

	// Canonical set. Three codes RETIRED with the root-model correction because the
	// conditions they named are now normal operation, not defects:
	//   duplicate_product_deal            -- there are no Product Deals to duplicate
	//   quote_product_mismatch            -- several Quote Products under one Deal is
	//                                        expected (a Product is a Quote, not a Deal)
	//   multi_product_sequence_ambiguous  -- several Products never made a Contact's
	//                                        sequence ambiguous; cadence is Contact-scoped
	// They are listed here as retired rather than deleted from the comment so a stale
	// caller is recognisable as stale.
	//
	// ⚠ NO COMMENTS INSIDE THE LITERAL. Deluge's parser rejects a `//` line between the
	// braces of a list or map literal ("no viable alternative at input"), so the grouping
	// notes for the codes added by the root-model correction live here instead:
	//   quote_product_cardinality, quote_header_line_mismatch
	//       -- Quote integrity (4.4). Quote-SCOPED, never Deal-product-scoped.
	//   multiple_deals_for_account, account_key_ambiguous
	//       -- Cardinality (4.2 / 4.7a K6). Never auto-merged, never auto-re-keyed.
	//   dispatch_deal_unresolved, send_commercials_no_deal, draft_commercials_no_deal
	//       -- Contact-only dispatch (2.4). Replaces the silent skip_missing_ids log lines.
	known = {
		"missing_product_interest",
		"product_unresolved",
		"quote_missing_contact",
		"non_decision_maker_quote_contact",
		"duplicate_open_quote",
		"activity_product_mismatch",
		"expansion_downgrade_attempt",
		"renewal_date_invalid",
		"quote_lifecycle_conflict",
		"target_acv_unresolved",
		"contract_product_conflict",
		"conflicting_opening_variant",
		"quote_product_cardinality",
		"quote_header_line_mismatch",
		"multiple_deals_for_account",
		"account_key_ambiguous",
		"dispatch_deal_unresolved",
		"send_commercials_no_deal",
		"draft_commercials_no_deal"
	};
	if(known.contains(key)) { return "[" + key + "]"; }

	automation.logAutomationEvent("resolveManualReviewCode", "-", "-", "unknown_review_code", "passthrough", {"key":key});
	return "[" + key + "]";
}
