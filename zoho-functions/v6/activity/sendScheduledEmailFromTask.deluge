void automation.sendScheduledEmailFromTask(string taskIdStr)
{
	// =========================================================================
	// sendScheduledEmailFromTask  (WFC-SchedEmail — date-based on Task.Due_Date)
	//
	// Fires when a scheduled-send wake-up Task's Due_Date is reached. Validates the
	// Task, parses the "ScheduledSend|stage=..|step=..|kind=.." payload, and delegates
	// ENTIRELY to sendSequencedEmail(..., taskId) — which owns template resolution,
	// idempotency, the send, and turning THIS Task into the Completed audit record.
	// On a successful post-call follow-up send, marks the Contact sequence Complete.
	// =========================================================================

	info "VERSION: v6-contact-centric";

	taskId = 0;
	if(!isNull(taskIdStr) && taskIdStr != "") { taskId = taskIdStr.toLong(); }
	if(taskId == 0) { return; }

	task = zoho.crm.getRecordById("Tasks", taskId);
	if(isNull(task) || isNull(task.get("id"))) { return; }

	desc = ifnull(task.get("Description"), "").toString();
	status = ifnull(task.get("Status"), "").toString();
	taskStatus = ifnull(task.get("Task_Status"), "").toString();
	if(!desc.contains("ScheduledSend|"))
	{
		automation.logAutomationEvent("sendScheduledEmailFromTask", "Tasks", taskId.toString(), "guard", "not_scheduled_send", null);
		return;
	}
	// Tasks has no Stale field; refuse to send any superseded/terminal scheduled-send Task.
	//
	// WORK ITEM 2.1-2.3 -- the `status == "Cancelled"` predicate is DELETED. "Cancelled" is NOT a
	// live Tasks.Status option (live set: Completed, Deferred, In Progress, Not Started, Waiting
	// on someone else), so the value could never be stored and the test could never be true. It
	// was dead by construction, and it read as though a supersede path existed that did not: the
	// old `{"Status":"Cancelled"}` write was discarded like any out-of-set picklist value, so a
	// superseded step still fired. The one valid supersede state is Status="Deferred" AND
	// Task_Status="Closed", and either alone already trips this gate. No replacement helper field.
	if(status == "Completed" || status == "Deferred" || taskStatus == "Closed")
	{
		automation.logAutomationEvent("sendScheduledEmailFromTask", "Tasks", taskId.toString(), "guard", "not_actionable_status", {"status":status, "task_status":taskStatus});
		return;
	}

	contactId = "";
	whoLookup = task.get("Who_Id");
	if(!isNull(whoLookup) && !isNull(whoLookup.get("id"))) { contactId = whoLookup.get("id").toString(); }
	dealId = "";
	whatLookup = task.get("What_Id");
	if(!isNull(whatLookup) && !isNull(whatLookup.get("id"))) { dealId = whatLookup.get("id").toString(); }
	// ---- WORK ITEM 2.4(5): the fifth and last Deal requirement ----
	// This was `contactId == "" || dealId == ""`, so EVERY scheduled step of a Contact-only email
	// chain died here, silently. The Contact is the required link; the Deal is context that
	// sendSequencedEmail now treats as optional. A wake-up Task with no Who_Id is still fatal --
	// there is no one to send to.
	if(contactId == "")
	{
		automation.logAutomationEvent("sendScheduledEmailFromTask", "Tasks", taskId.toString(), "guard", "missing_contact_link", {"contact":contactId, "deal":dealId});
		return;
	}

	// parse payload "ScheduledSend|stage=<>|step=<>|kind=<>"
	stage = "";
	step = 0;
	kind = "";
	parts = desc.getPrefix("\n").toList("|");
	for each p in parts
	{
		if(p.startsWith("stage=")) { stage = p.removeFirstOccurence("stage="); }
		else if(p.startsWith("step=")) { step = p.removeFirstOccurence("step=").toLong(); }
		else if(p.startsWith("kind=")) { kind = p.removeFirstOccurence("kind="); }
	}

	// delegate everything (template / idempotency / send / audit-Task update) to sendSequencedEmail
	msgId = automation.sendSequencedEmail(contactId, dealId, stage, step, kind, taskId.toString(), "");

	// ---- WORK ITEM 2.1-2.3: the chain advances ITSELF ----
	// With the 5-Call escalation removed there is no Call n+1 to carry the next cadence email,
	// so the step that just completed schedules its successor. Same +2-business-day spacing the
	// escalation used, same payload, through the shared scheduler.
	//
	// After step 5 the Stage's cadence is Complete. Steps 1-5 map to
	// <stage-slug>:1:initial, :2:follow-up, :3:follow-up, :4:follow-up, :5:final.
	if(msgId != "" && kind == "cadence")
	{
		if(step >= 1 && step < 5)
		{
			nextSched = automation.scheduleCadenceStep(contactId, dealId, stage, step + 1, "cadence", 2, "");
			automation.logAutomationEvent("sendScheduledEmailFromTask", "Tasks", taskId.toString(), "chain_advance", if(nextSched != "", "scheduled_step_" + (step + 1), "not_scheduled"), {"contact":contactId, "stage":stage, "from_step":step.toString()});
			zoho.crm.updateRecord("Contacts", contactId.toLong(), {"Sequence_Step": (step + 1).toString()}, {"trigger": List()});
		}
		else
		{
			// step 5 (or an out-of-range step): terminal. No successor is scheduled.
			zoho.crm.updateRecord("Contacts", contactId.toLong(), {"Sequence_State": "Complete"}, {"trigger": List()});
			automation.logAutomationEvent("sendScheduledEmailFromTask", "Tasks", taskId.toString(), "chain_advance", "cadence_complete", {"contact":contactId, "stage":stage, "step":step.toString()});
		}
	}
	if(msgId != "" && kind == "postcall")
	{
		// Legacy terminal kind, retained: <slug>:5:final is also reachable as kind="postcall"
		// from paths that pre-date the chain rework (and from any wake-up Task still carrying
		// that payload when this publishes). Same terminal outcome.
		zoho.crm.updateRecord("Contacts", contactId.toLong(), {"Sequence_State": "Complete"}, {"trigger": List()});
	}
	automation.logAutomationEvent("sendScheduledEmailFromTask", "Tasks", taskId.toString(), "delegated", if(msgId != "", "sent", "not_sent"), {"contact":contactId, "deal":dealId, "kind":kind});
}
