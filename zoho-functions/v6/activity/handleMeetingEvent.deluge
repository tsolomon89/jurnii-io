void automation.handleMeetingEvent(string eventIdStr)
{
	// =========================================================================
	// handleMeetingEvent  (Meeting/Event = source of truth — WF007)
	//
	// Driven by the Event's OWN live state-centric fields. Legacy Meeting_Status,
	// Meeting_Type, and Meeting_Outcome are not read:
	//   - Meeting_Task_State  : Open / Won / Lost  (result + lifecycle surface)
	//   - Meeting_Task_Stage  : 8-stage; infers meeting TYPE (demo/commercial/renewal)
	//   - Meeting_Task_Lost_Reasons : scoped loss
	//   - Meeting_Task_Contract_Products|Brands|Date_Start|Date_End : commercial evidence
	//   - Start_DateTime / Reminder_Send_At
	//
	// TYPE inference from Meeting_Task_Stage (Meeting_Type retired): rank <= Demo Hosted
	// -> demo; Proposal Preparation/Commercial Agreement -> commercial; Onboarding/Renewal
	// -> renewal. Blank stage falls back to the Contact's Stage, else demo.
	//
	// STATE:
	//   Open / blank -> UPCOMING: (re)compute reminder + first-booking advance (demo only).
	//   Won  -> demo: route demo:qualified (carries Product contextJson); commercial/renewal:
	//           promote evidence straight to processDeal (Quote upsert + term gate own signing).
	//   Lost -> resolveActivityLoss (module-relative). Activity loss never closes the Deal
	//           from a reason alone; possible opportunity loss is surfaced for review.
	// =========================================================================

	info "VERSION: v6-meeting-state";

	eventId = 0;
	if(!isNull(eventIdStr) && eventIdStr != "") { eventId = eventIdStr.toLong(); }
	automation.logAutomationEvent("handleMeetingEvent", "Events", ifnull(eventId, "").toString(), "entry", "in_progress", null);
	if(eventId == 0) { return; }

	event = zoho.crm.getRecordById("Events", eventId);
	if(isNull(event) || isNull(event.get("id"))) { return; }

	whatLookup = event.get("What_Id");
	seModule   = ifnull(event.get("$se_module"), "").toString();
	if(isNull(whatLookup) || isNull(whatLookup.get("id")) || seModule != "Deals")
	{
		automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "guard", "skip_no_related_deal", {"se_module":seModule});
		return;
	}
	dealId = whatLookup.get("id").toLong();

	deal = zoho.crm.getRecordById("Deals", dealId);
	if(isNull(deal) || isNull(deal.get("id"))) { return; }

	// Contact: prefer the Meeting's Who_Id; fall back to Deal.Contact_Name.
	// CHANGE 15: the fallback is kept for the NON-ACTIVITY paths (reminder computation, activity
	// mirrors, type inference) but must not feed the router on a terminal path. The router's
	// activity context requires Event.Who_Id == contactId, so a fallback Contact is rejected with
	// who_id_mismatch - a void call whose failure used to be invisible while the Event was
	// nevertheless marked Closed, permanently trapping it behind MTG-4.
	contactId = "";
	contactFromWhoId = false;
	whoLookup = event.get("Who_Id");
	if(!isNull(whoLookup) && !isNull(whoLookup.get("id")))
	{
		contactId = whoLookup.get("id").toString();
		contactFromWhoId = true;
	}
	if(contactId == "")
	{
		cnLookup = deal.get("Contact_Name");
		if(!isNull(cnLookup) && !isNull(cnLookup.get("id"))) { contactId = cnLookup.get("id").toString(); }
	}

	noTrigger = Map();
	noTrigger.put("trigger", List());

	// Real newline for rep-facing Description text. This org's Deluge stores a literal backslash-n
	// instead of a line break (verified live 2026-07-07), so line breaks must come from an actual
	// newline character. hextoText("0A") = line feed (a raw newline in a string literal is not valid Deluge here).
	nl = hextoText("0A");

	mState = ifnull(event.get("Meeting_Task_State"), "").toString().trim();
	if(mState == "-None-") { mState = ""; }
	mReason = ifnull(event.get("Meeting_Task_Lost_Reasons"), "").toString().trim();
	if(mReason == "-None-") { mReason = ""; }
	mStage = ifnull(event.get("Meeting_Task_Stage"), "").toString().trim();

	// MTG-4 idempotency: a terminal Meeting_Task_State already processed (Meeting_Task_Status
	// mirror = Closed) must not re-route on a later edit (WF007 fires on create_or_edit). A
	// later unrelated edit on a Won/Lost+Closed meeting must not rerun
	// routing/processDeal/createAuxTask. Mirrors handleTaskCompletion.
	mStatus = ifnull(event.get("Meeting_Task_Status"), "").toString().trim();
	if((mState == "Won" || mState == "Lost") && mStatus == "Closed")
	{
		automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "guard", "skip_state_already_processed", {"meeting_state":mState});
		return;
	}

	// ---- CHANGE 14 + 15: a TERMINAL state with no usable Contact must not fall through -------
	// Previously a Won/Lost meeting whose Contact could not be resolved fell past both terminal
	// branches (each requires contactId != "") into the UPCOMING branch, which writes
	// Meeting_Task_Status = "New" onto a terminal meeting - permanently defeating MTG-4, since
	// the record can then never reach Closed by any path.
	// The router will also REJECT a Contact that came from the Deal.Contact_Name fallback
	// (who_id_mismatch, because the activity context requires Event.Who_Id == contactId), so on a
	// terminal path an unusable Contact is treated exactly like a missing one. Writing the
	// resolved Contact back into Event.Who_Id would also work but mutates a rep-owned
	// relationship field, so the inert path is preferred.
	if((mState == "Won" || mState == "Lost") && (contactId == "" || !contactFromWhoId))
	{
		zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_Status":"Working"}, noTrigger);
		automation.createManualReview(contactId, dealId.toString(), "meeting_contact_unresolved", "Meeting " + eventId + " was set to " + mState + " but its Contact could not be resolved from the meeting itself (Who_Id is blank). Nothing was routed and the meeting was NOT closed, so it can be reprocessed. Set the meeting's Contact (Who_Id), then set Meeting_Task_State = " + mState + " again.");
		automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "guard", "terminal_state_no_contact", {"meeting_state":mState, "deal":dealId.toString(), "contact_from_who_id":contactFromWhoId.toString()});
		return;
	}

	// F3 FIX: Deluge getRecordById omits the special Pipeline field; resolve via the shared resolver.
	dealPipeline = automation.resolveDealPipeline(dealId.toString());
	dealOppType  = ifnull(deal.get("Stage"), "").toString();

	// ---- TYPE inference from Meeting_Task_Stage (fallback to Contact Stage, else demo) ----
	stageRanks = {"Marketing Consent":1, "Demo Booking":2, "Demo Confirmation":3, "Demo Hosted":4, "Proposal Preparation":5, "Commercial Agreement":6, "Onboarding":7, "Renewal":8};
	contactStage = "";
	seqState = "";
	if(contactId != "")
	{
		cFull = zoho.crm.getRecordById("Contacts", contactId.toLong());
		if(!isNull(cFull) && !isNull(cFull.get("id")))
		{
			contactStage = ifnull(cFull.get("Stage"), "").toString();
			seqState = ifnull(cFull.get("Sequence_State"), "").toString().trim();
		}
	}
	// MTG-1: hasNextStep must reflect ACTUAL Contact sequence exhaustion, not a hard-coded "false".
	// Only genuine recovery exhaustion (Sequence_State == 'Complete') escalates No Response to Contact Lost.
	hasNext = "true";
	if(seqState == "Complete") { hasNext = "false"; }
	if(mStage == "") { mStage = contactStage; }
	mRank = ifnull(stageRanks.get(mStage), 0).toLong();
	isCommercial = (mRank == 5 || mRank == 6);
	isRenewal = (mRank >= 7);
	isDemo = (!isCommercial && !isRenewal);   // ranks 1-4 and blank/unknown -> demo

	// ---- build the activity contextJson once for a Won meeting (commercial evidence) ----
	ctxStr = "{}";
	if(mState == "Won")
	{
		actx = Map();
		actx.put("source", "activity");
		actx.put("sourceModule", "Events");
		actx.put("sourceActivityId", eventId.toString());
		actx.put("contactId", contactId);
		actx.put("activityState", "Won");
		prodList = List();
		rawProds = event.get("Meeting_Task_Contract_Products");
		if(!isNull(rawProds))
		{
			for each pv in rawProds
			{
				pvs = ifnull(pv, "").toString().trim();
				if(pvs != "" && pvs != "-None-") { prodList.add(pvs); }
			}
		}
		actx.put("products", prodList);
		mBrands = ifnull(event.get("Meeting_Task_Contract_Brands"), "").toString().trim();
		if(mBrands != "" && mBrands.matches("[0-9]+")) { actx.put("numberOfBrands", mBrands.toLong()); }
		mStart = ifnull(event.get("Meeting_Task_Contract_Date_Start"), "").toString().trim();
		if(mStart != "") { actx.put("contractDateStart", mStart); }
		mEnd = ifnull(event.get("Meeting_Task_Contract_Date_End"), "").toString().trim();
		if(mEnd != "") { actx.put("contractDateEnd", mEnd); }
		mFreq = ifnull(event.get("Meeting_Task_Contract_Frequency"), "").toString().trim();
		if(mFreq == "-None-") { mFreq = ""; }
		if(mFreq != "") { actx.put("frequency", mFreq); }
		ctxStr = actx.toString();
	}

	// =====================================================================
	// COMMERCIAL / RENEWAL meeting
	// =====================================================================
	if(isCommercial || isRenewal)
	{
		if(mState == "Won")
		{
			// Promote the commercial evidence straight to processDeal: it links Products,
			// upserts the per-Product Quote, recomputes Amount/ledger, and the term-complete
			// gate owns any commercial:signed advance (a meeting expresses intent; the Quote
			// owns the signed ledger). No Deal intent/timestamp phantom fields are stamped.
			pdRes = automation.processDeal(dealId.toString(), ctxStr);
			pdMap = Map();
			if(!isNull(pdRes) && pdRes.toString().trim() != "") { pdMap = pdRes.toString().toMap(); }
			if(ifnull(pdMap.get("success"), false) != true)
			{
				if(contactId != "") { automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "Commercial meeting " + eventId + " could not apply Product/Quote evidence after Meeting_Task_State=Won. Resolve the validation issue and set Meeting_Task_State=Won again."); }
				zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_State":"Open", "Meeting_Task_Status":"Working"}, noTrigger);
				automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "commercial_meeting", "won_reopened_validation_failed", {"deal":dealId.toString(), "products":prodList.size().toString(), "pd":ifnull(pdRes, "").toString()});
				return;
			}
			zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_Status":"Closed"}, noTrigger);
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "commercial_meeting", "won_evidence_promoted", {"deal":dealId.toString(), "products":prodList.size().toString(), "pd":ifnull(pdRes, "").toString()});
		}
		else if(mState == "Lost")
		{
			if(mReason == "")
			{
				if(contactId != "") { automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "Commercial meeting " + eventId + " was marked Lost without Meeting Lost Reasons. Add a canonical Lost Reason, then set Meeting_Task_State=Lost again."); }
				zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_State":"Open", "Meeting_Task_Status":"Working"}, noTrigger);
				automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "commercial_meeting_lost", "missing_reason_reopened", {"deal":dealId.toString()});
				return;
			}
			// A single Lost commercial meeting does NOT auto-close the Deal. Terms
			// Rejected/Churned surfaces Manual Review; actual Deal closure requires an
			// explicit Deal-level loss decision or Quote Closed Lost rollup.
			// MTG-1: hasNext (from Sequence_State) goes in the hasNextStep (3rd) slot;
			// meetingContext stays "false" for the commercial-meeting path.
			lossRaw = automation.resolveActivityLoss(mReason, "activity", hasNext, "false", "false");
			loss = Map();
			if(!isNull(lossRaw) && lossRaw.toString().trim() != "") { loss = lossRaw.toString().toMap(); }
			act = ifnull(loss.get("action"), "manual_review").toString();
			// CHANGE 13: the Meeting_Task_Status = "Closed" write MOVED to AFTER the loss action
			// and is now VERIFIED. Every terminal write must follow confirmation of the intended
			// effect - never mark processed before the outcome is known. createAuxTask returns a
			// Task id, so "" is a detectable failure. lostActionOk tracks that.
			lostActionOk = true;
			if(act == "deal_lost" && contactId != "")
			{
				lostRefId = automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "Commercial meeting " + eventId + " Lost (" + mReason + ") suggests opportunity loss. Make an explicit Deal-level loss decision; activity loss alone does not close the Deal.");
				if(ifnull(lostRefId, "").toString() == "") { lostActionOk = false; }
			}
			else if(act == "contact_lost" && contactId != "")
			{
				// CHANGE 16: loss is LOCAL. A Lost meeting describes that meeting only. This now
				// matches how act == "deal_lost" is already handled immediately above.
				clr = ifnull(loss.get("contactLostReason"), "No Response").toString();
				automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "[activity_lost_suggests_contact_loss] Meeting " + eventId + " Lost (" + clr + ") with the Contact's sequence exhausted. Closing the Contact is an explicit Contact-level decision; activity loss alone does not make the Contact or Deal Lost.");
				automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "activity_lost_contact_loss_referred", clr, {"contact":contactId, "deal":dealId.toString()});
			}
			else if(act == "find_decision_maker" && contactId != "")
			{
				automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "[no_authority] Commercial meeting " + eventId + ": Find Decision Maker (No Authority). Deal stays Open.");
			}
			else if(act == "data_repair" && contactId != "")
			{
				automation.createAuxTask(contactId, dealId.toString(), "Data Repair", "Commercial meeting " + eventId + ": bad data - repair before continuing.");
			}
			else
			{
				if(contactId != "") { automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "Commercial meeting " + eventId + " Lost (" + mReason + ") - review (re-book, find another contact, or close the opportunity). Deal stays Open unless terms finally rejected."); }
			}
			// Verified close: only record the meeting as processed once the loss action landed.
			if(lostActionOk)
			{
				zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_Status":"Closed"}, noTrigger);
			}
			else
			{
				zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_State":"Open", "Meeting_Task_Status":"Working"}, noTrigger);
				automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "commercial_meeting_lost", "lost_reopened_action_not_applied", {"deal":dealId.toString(), "action":act});
			}
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "commercial_meeting_lost", act, {"deal":dealId.toString(), "reason":mReason});
		}
		else
		{
			// Open / blank -> discussed but not concluded; no live action (Quote owns the ledger).
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "commercial_meeting", "open_no_terminal", {"deal":dealId.toString(), "state":mState});
		}
		return;
	}

	// =====================================================================
	// DEMO meeting — RESULT (Won/Lost) or UPCOMING (Open/blank)
	// =====================================================================
	if(mState == "Won" && contactId != "")
	{
		// demo qualified -> advance; carry any Product evidence to processDeal (via the router)
		automation.routeContactSequence(contactId, dealId.toString(), "demo:qualified", ctxStr);

		// ---- CHANGE 13: VERIFIED close. routeContactSequence is void, so success cannot be
		// returned; rather than change its signature (20+ call sites, out of scope) verify the
		// OBSERVABLE OUTCOME, exactly as the commercial-Won path already verifies processDeal.
		// Success is "Proposal Preparation or ANY LATER Stage" - NOT "the Stage changed". A
		// Contact already at Onboarding therefore closes successfully with no regression
		// (Change 12) and no duplicate Draft Commercials work; it must not reopen merely because
		// the Stage did not move. The reopen path is reserved for genuine routing failure, and it
		// makes retry real: MTG-4 no longer traps the Event.
		wonPostStage = "";
		wonContact = zoho.crm.getRecordById("Contacts", contactId.toLong());
		if(!isNull(wonContact) && !isNull(wonContact.get("id"))) { wonPostStage = ifnull(wonContact.get("Stage"), "").toString().trim(); }
		wonRank = ifnull(stageRanks.get(wonPostStage), 0).toLong();
		if(wonRank >= ifnull(stageRanks.get("Proposal Preparation"), 5).toLong())
		{
			zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_Status":"Closed"}, noTrigger);
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "result_won", "won_routed", {"deal":dealId.toString(), "products":prodList.size().toString(), "stage":wonPostStage});
		}
		else
		{
			zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_State":"Open", "Meeting_Task_Status":"Working"}, noTrigger);
			automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "[meeting_route_not_applied] Meeting " + eventId + " was set to Won but the Contact did not reach Proposal Preparation or later (Stage is now '" + wonPostStage + "'), so the meeting was NOT closed and can be reprocessed. Check the meeting's Contact and Deal relationships, then set Meeting_Task_State = Won again.");
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "result_won", "won_reopened_route_not_applied", {"deal":dealId.toString(), "stage":wonPostStage});
		}
		return;
	}
	if(mState == "Lost" && contactId != "")
	{
		if(mReason == "")
		{
			automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "Demo " + eventId + " was marked Lost without Meeting Lost Reasons. Add a canonical Lost Reason, then set Meeting_Task_State=Lost again.");
			zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_State":"Open", "Meeting_Task_Status":"Working"}, noTrigger);
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "result_lost", "missing_reason_reopened", {"deal":dealId.toString()});
			return;
		}
		// MTG-1: hasNext (from Sequence_State) goes in the hasNextStep (3rd) slot;
		// meetingContext stays "true" for the demo path so 'No Meeting / Demo' -> continue_cadence -> demo:followup.
		lossRaw = automation.resolveActivityLoss(mReason, "activity", hasNext, "false", "true");
		loss = Map();
		if(!isNull(lossRaw) && lossRaw.toString().trim() != "") { loss = lossRaw.toString().toMap(); }
		act = ifnull(loss.get("action"), "manual_review").toString();
		// CHANGE 13: the Closed write MOVED to AFTER the loss action and is now verified. Lost
		// state is still terminal for the Event, but it is only RECORDED as processed once the
		// action it implies has actually landed.
		lostActionOk = true;
		if(act == "continue_cadence")
		{
			// SEQ-1: No Meeting / Demo (missed/lost demo) -> keep the Contact at Demo Hosted
			// (State=Open, Status=Working) and run the 5-step Demo Hosted RECOVERY cadence
			// (demo-hosted:1..5). Routed via 'demo:followup'. The recovery's sole immediate
			// opener email is demo-hosted:1:initial; do NOT send a one-off no-show email from
			// here (routeContactSequence suppresses demo_no_show on this path).
			// 'demo:noshow' is reserved ONLY for a genuine confirmed-meeting no-show that should
			// rebook (reverts to Demo Booking); it must NOT be used for No Meeting/Demo recovery.
			automation.routeContactSequence(contactId, dealId.toString(), "demo:followup", "{}");
		}
		else if(act == "contact_lost")
		{
			// CHANGE 16: loss is LOCAL. 'No Response' on an exhausted sequence must not mark the
			// Contact Lost, and must never close the Deal.
			clr = ifnull(loss.get("contactLostReason"), "No Response").toString();
			automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "[activity_lost_suggests_contact_loss] Demo " + eventId + " Lost (" + clr + ") with the Contact's sequence exhausted. Closing the Contact is an explicit Contact-level decision; activity loss alone does not make the Contact or Deal Lost.");
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "activity_lost_contact_loss_referred", clr, {"contact":contactId, "deal":dealId.toString()});
		}
		else if(act == "find_decision_maker")
		{
			automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "[no_authority] Demo " + eventId + ": Find Decision Maker (No Authority). Deal stays Open.");
		}
		else if(act == "data_repair")
		{
			automation.createAuxTask(contactId, dealId.toString(), "Data Repair", "Demo " + eventId + ": bad data - repair before continuing.");
		}
		else if(act == "suppress")
		{
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "result_lost", "suppress", {"deal":dealId.toString()});
		}
		else
		{
			lostRefId2 = automation.createAuxTask(contactId, dealId.toString(), "Manual Review", "Demo " + eventId + " marked Lost (" + mReason + ") - review (reschedule, find another contact, or close the Contact). Deal stays Open.");
			if(ifnull(lostRefId2, "").toString() == "") { lostActionOk = false; }
		}
		// Verified close. Reopen is the retry path: a reopened record is reprocessed on the next
		// save, which is exactly why the truthfulness fix and MTG-4 are compatible - MTG-4 only
		// traps records genuinely marked Closed.
		if(lostActionOk)
		{
			zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_Status":"Closed"}, noTrigger);
		}
		else
		{
			zoho.crm.updateRecord("Events", eventId, {"Meeting_Task_State":"Open", "Meeting_Task_Status":"Working"}, noTrigger);
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "result_lost", "lost_reopened_action_not_applied", {"deal":dealId.toString(), "action":act});
		}
		automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "result_lost", act, {"deal":dealId.toString(), "reason":mReason});
		return;
	}

	// ---- UPCOMING (Open / blank): (re)compute reminder + mirror + first-booking advance ----
	//
	// REMINDER RULE (verified live 2026-08-02, journey c3a9b7d7…):
	//   Compute the normal one-business-day-before reminder, then write it ONLY when it is
	//   still in the future. A demo booked at short notice resolves to a reminder that has
	//   already passed - that run produced Reminder_Send_At = 2026-07-31 08:00 for a
	//   2026-08-03 meeting booked on 2026-08-02, three days stale on arrival.
	//
	//   A past value is NOT clamped to now: WF010c's template says the demo is *tomorrow*,
	//   so firing it immediately would send a factually wrong email. An unset reminder is
	//   the correct representation of "there was no time to remind them in advance".
	//
	//   `now` is the Zoho server clock in the org timezone, which is also the frame
	//   calculateBusinessDate returns, so the comparison is like-for-like.
	startDateTime = event.get("Start_DateTime");
	reminderAt = null;
	reminderSkippedPast = false;
	if(!isNull(startDateTime))
	{
		reminderAtStr = automation.calculateBusinessDate(startDateTime, -1, "business_days_minus_AM");
		reminderDt = reminderAtStr.toDateTime("yyyy-MM-dd HH:mm:ss");
		if(reminderDt > now)
		{
			reminderAt = reminderDt.toString("yyyy-MM-dd'T'HH:mm:ssXXX");
		}
		else
		{
			reminderSkippedPast = true;
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "reminder", "skipped_already_past", {"computed":reminderAtStr.toString(), "start":startDateTime.toString()});
		}
	}

	evUpd = Map();
	if(reminderAt != null) { evUpd.put("Reminder_Send_At", reminderAt); }
	if(dealPipeline != "") { evUpd.put("Meeting_Task_Pipeline", dealPipeline); }
	if(dealOppType != "")  { evUpd.put("Meeting_Task_Opportunity", dealOppType); }
	// Field-update contract for the rep. v6 does not CREATE meetings (they are booked externally), so
	// stamp the guidance on the first UPCOMING pass - but ONLY when the rep has not written their own
	// agenda/notes into Description (never overwrite user content). handleMeetingEvent reads Meeting Task
	// State (+ Contract fields) on save and advances the sequence / upserts the Quote.
	// CHANGE 17: APPEND the guidance when it is absent, rather than only writing when Description
	// is blank. The blank-only check never fired on a booked demo, because the booking backend
	// always writes a non-blank Description ("Booking Reference:" is unconditional), so the one
	// population that most needs the contract never saw it. Detection is by a stable marker
	// substring so it appends exactly ONCE and never overwrites a rep's agenda.
	evDescNow = ifnull(event.get("Description"), "").toString();
	if(!evDescNow.contains("Automation-managed meeting."))
	{
		// The product-conditional requirements are derived from _util_resolveQuoteLinePrice, not
		// invented: Brands are required for all products, Frequency is Jurnii 360 only, and
		// Jurnii Cortex cannot be auto-priced. Same shape as the Draft Commercials description.
		evGuide = "Automation-managed meeting." + nl + "After it happens, log the result on this Event:" + nl + "- Went ahead / qualified -> set Meeting Task State = Won" + nl + "- Did not happen / lost -> set Meeting Task State = Lost + choose Meeting Task Lost Reasons" + nl + "If commercial terms were discussed, quoted or agreed, also fill the Meeting Task Contract fields before Won:" + nl + "- Meeting Task Contract Products and Meeting Task Contract Brands are required for every product." + nl + "- Meeting Task Contract Date Start and Date End are required." + nl + "- Meeting Task Contract Frequency is required for Jurnii 360 ONLY." + nl + "- Jurnii Cortex cannot be priced automatically; it raises a Manual Review for manual pricing." + nl + "Automation builds the Quote from these fields - do not enter Quote data yourself." + nl + "Do not edit Meeting Task Status, Reminder Send At, or the Stage / Pipeline fields - automation advances the sequence (and creates/updates the Quote from the Contract fields) once you save the result.";
		if(evDescNow.trim() == "") { evUpd.put("Description", evGuide); }
		else { evUpd.put("Description", evDescNow + nl + nl + evGuide); }
	}
	if(mStage != "" && ifnull(event.get("Meeting_Task_Stage"), "").toString() == "") { evUpd.put("Meeting_Task_Stage", mStage); }
	if(ifnull(event.get("Meeting_Task_Status"), "").toString() == "") { evUpd.put("Meeting_Task_Status", "New"); }
	if(evUpd.size() > 0) { zoho.crm.updateRecord("Events", eventId, evUpd, noTrigger); }

	// Deal summary mirror (kept while WF010c remains Deal-based on Demo_Reminder_Send_At).
	//
	// `Demo_Start_DateTime` DOES NOT EXIST on the Deals module - confirmed against live
	// metadata on 2026-08-02 (70 Deal fields; the only Demo/Reminder field is
	// Demo_Reminder_Send_At). Because Deluge sends one updateRecord map, the unknown key
	// took the SUPPORTED key down with it: Demo_Reminder_Send_At came back null on every
	// Deal, so WF010c could never fire for any booking. The field is removed rather than
	// created - nothing reads a Deal-level demo start, the Event's Start_DateTime is the
	// source of truth for it, and inventing a field to satisfy stale code would duplicate
	// state that already has an owner.
	//
	// The reminder write now stands alone, so it succeeds or fails on its own merits.
	dUpd = Map();
	if(reminderAt != null) { dUpd.put("Demo_Reminder_Send_At", reminderAt); }
	if(dUpd.size() > 0) { zoho.crm.updateRecord("Deals", dealId, dUpd, noTrigger); }

	// First booking only -> advance the Contact to Demo Confirmation (router owns it + the
	// Confirmation email). Idempotent: only when the Contact has not yet reached Demo Confirmation.
	if(contactId != "")
	{
		contactRank = ifnull(stageRanks.get(contactStage), 0).toLong();
		demoConfRank = 3;
		if(contactRank < demoConfRank)
		{
			automation.routeContactSequence(contactId, dealId.toString(), "meeting:created", "{}");
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "first_booking", "meeting_created", {"deal":dealId.toString(), "contact_stage":contactStage});
		}
		else
		{
			automation.logAutomationEvent("handleMeetingEvent", "Events", eventId.toString(), "upcoming_mirrored", mState, {"deal":dealId.toString(), "contact_stage":contactStage});
		}
	}
}
