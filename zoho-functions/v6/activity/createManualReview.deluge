string automation.createManualReview(string contactIdStr, string dealIdStr, string codeKey, string detail)
{
	// =========================================================================
	// createManualReview   (VERSION: v6-product-deal)
	//
	// Thin convenience wrapper. It resolves a canonical review code via
	// resolveManualReviewCode, prepends it to the note, then delegates to
	// createAuxTask("Manual Review", ...).
	//
	// Because the note LEADS with the canonical "[code]" token, createAuxTask's
	// existing append-issue dedup makes repeated fires idempotent per Contact and
	// accumulates DISTINCT codes on one reusable Manual Review task.
	//
	// WORK ITEM 2.4 -- this function used to carry a SECOND, duplicate Task-creation
	// implementation for the Contact-only case, because createAuxTask hard-returned ""
	// without a Deal. createAuxTask is now Deal-optional, so that duplicate is deleted
	// and there is one Task constructor again. The duplicate also told the rep "no Deal
	// is linked, so completing this task does not advance a sequence by itself", which
	// 2.4 makes false: handleTaskCompletion no longer returns at a no-related-deal
	// guard, so a Contact-only review DOES drive automation on save.
	//
	// Returns the Manual Review Task id (new or reused), or "".
	// =========================================================================
	code = automation.resolveManualReviewCode(codeKey);
	note = code;
	det = ifnull(detail, "").toString().trim();
	if(det != "") { note = code + " " + det; }

	cId = ifnull(contactIdStr, "").toString().replaceAll("zcrm_", "").trim();
	dId = ifnull(dealIdStr, "").toString().replaceAll("zcrm_", "").trim();

	// createAuxTask requires a Contact (Who_Id). Several review codes legitimately
	// arrive with none (e.g. quote_missing_contact, product_unresolved), so fall back
	// to the Deal's controlling Contact rather than dropping the review.
	//
	// WORK ITEM 5.1 -- reader 1 of 3 collapsed off Deal_Primary_Contact. That field's
	// only writer targeted a phantom api_name, so it has never held a value on any
	// Deal and this branch has always fallen through to Contact_Name anyway.
	// Contact_Name is the canonical controlling Deal Contact.
	if(cId == "" && dId != "" && dId.matches("[0-9]+"))
	{
		dealRec = zoho.crm.getRecordById("Deals", dId.toLong());
		if(!isNull(dealRec) && !isNull(dealRec.get("id")))
		{
			cn = dealRec.get("Contact_Name");
			if(!isNull(cn) && !isNull(cn.get("id"))) { cId = cn.get("id").toString(); }
		}
	}

	// The Contact-only branch that used to live here is DELETED (work item 2.4). It
	// duplicated createAuxTask's dedupe, description footer and create map purely to
	// work around createAuxTask's old Deal requirement. createAuxTask now handles
	// dealId == "" natively -- Who_Id required, What_Id optional -- so the single
	// delegation below covers the Deal-scoped and Contact-only cases alike.
	taskId = automation.createAuxTask(cId, dId, "Manual Review", note);
	if(taskId == "")
	{
		// never let a review vanish silently -- surface the unresolvable case in the log.
		// Post-2.4 the only remaining cause is a missing CONTACT (or a failed create),
		// since a missing Deal is now a supported shape.
		automation.logAutomationEvent("createManualReview", "Contacts", cId, "review_not_created", "no_contact", {"code":code, "detail":det, "deal":dId});
	}
	return taskId;
}
