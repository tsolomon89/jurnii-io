void automation.rollupAccountState(string accountId)
{
	// =========================================================================
	// _util_rollupAccountState   (VERSION: v6-product-deal)
	//
	// Aggregate Product-Deal state onto the Account (spec M1 / doc 00,05):
	//   Account.State        = "Lost" ONLY when EVERY Product Deal is Lost; else "Open".
	//                          (Never "Won" -- mirrors decision 2: Deals are never Won.)
	//   Account.Account_Status = "Churned"        when all Product Deals Lost
	//                          = "Active Customer" when >=1 Deal is signed/active (RTP)
	//                          = "Prospect"        otherwise (open, none signed yet)
	//
	// "Signed/active" = the Deal reached the RTP floor (Opportunity_Stage in {Onboarding,
	// Renewal}) OR carries at least one Closed Won Quote (D1: Closed Won is the SIGNED event, so a
	// Deal signed via a Closed Won Quote whose Contact has not yet reached Onboarding still counts as
	// an Active Customer). Silenced duplicate Deals (blank Deal_Key) are excluded.
	// Writes ONLY Accounts.State (Open/Lost) + Accounts.Account_Status; NEVER Accounts.Status.
	//
	// Writes use trigger suppression so the Account WFC does not cascade. Does not
	// touch Account.Status (New/Working/Closed) -- that value set is not part of the
	// spec rollup.
	// =========================================================================
	accId = ifnull(accountId, "").toString().replaceAll("zcrm_", "").trim();
	if(accId == "" || !accId.matches("[0-9]+")) { return; }

	noTrigger = Map();
	noTrigger.put("trigger", List());

	deals = zoho.crm.getRelatedRecords("Deals", "Accounts", accId.toLong());
	total = 0;
	lost = 0;
	signed = 0;
	if(!isNull(deals) && deals.size() > 0 && !deals.toString().startsWith("{\"code\""))
	{
		for each d in deals
		{
			did = ifnull(d.get("id"), "").toString();
			if(did == "" || !did.matches("[0-9]+")) { continue; }
			full = zoho.crm.getRecordById("Deals", did.toLong());
			if(isNull(full) || isNull(full.get("id"))) { continue; }
			// ---- WORK ITEM 3.3: the Product-Deal scoping is REMOVED ----
			// This used to count ONLY "genuine Product Deals", skipping any Deal with no Product
			// identity and any Deal whose key ended "::active". Under the corrected model the
			// canonical Deal has NO Product identity (a Product is a Quote under it) and its key
			// is exactly the Account_Key with no "::" suffix -- so BOTH tests excluded the only
			// Deal that now exists. The roll-up would have iterated the Account's one real Deal
			// and skipped it, then written a state derived from zero Deals.
			//
			// A blank Deal_Key is still skipped: that is a silenced duplicate, and it is a
			// data-integrity marker rather than a Product-model artefact.
			//
			// Deal_Product_Key / Deal_Product are no longer read here at all -- both are
			// scheduled for retirement, and a reader kept "just in case" is what turns a
			// retirement into a phantom-field incident.
			dKey = ifnull(full.get("Deal_Key"), "").toString().trim();
			if(dKey == "") { continue; }

			total = total + 1;
			st = ifnull(full.get("Opportunity_State"), "Open").toString();
			if(st == "Lost") { lost = lost + 1; }
			// signed/active = RTP-floor stage OR >=1 Closed Won Quote on the Deal (D1 signed event).
			// Only fetch Quotes when the stage check hasn't already proven it (avoids extra reads).
			stage = ifnull(full.get("Opportunity_Stage"), "").toString();
			isSignedDeal = (stage == "Onboarding" || stage == "Renewal");
			if(!isSignedDeal)
			{
				dQuotes = zoho.crm.getRelatedRecords("Quotes", "Deals", did.toLong());
				if(!isNull(dQuotes) && dQuotes.size() > 0 && !dQuotes.toString().startsWith("{\"code\""))
				{
					for each dqx in dQuotes
					{
						dqxId = "";
						if(!isNull(dqx.get("id"))) { dqxId = dqx.get("id").toString(); }
						if(dqxId == "" || !dqxId.matches("[0-9]+")) { continue; }
						dqxFull = zoho.crm.getRecordById("Quotes", dqxId.toLong());
						if(!isNull(dqxFull) && ifnull(dqxFull.get("Quote_Stage"), "").toString() == "Closed Won") { isSignedDeal = true; }
					}
				}
			}
			if(isSignedDeal) { signed = signed + 1; }
		}
	}

	if(total == 0)
	{
		automation.logAutomationEvent("rollupAccountState", "Accounts", accId, "rollup", "no_product_deals", null);
		return;
	}

	acctState = "";
	acctStatus = "";
	if(lost == total)
	{
		acctState = "Lost";
		acctStatus = "Churned";
	}
	else
	{
		acctState = "Open";
		acctStatus = if(signed > 0, "Active Customer", "Prospect");
	}

	// ---- WORK ITEM 3.3 / 5.1: Accounts.State and Accounts.Account_Status are RETIRED ----
	//
	// Both were WRITE-ONLY. Verified: this function was the sole writer of Account_Status, and
	// there are ZERO readers across all 38 Deluge files and all of booking/ (the only booking
	// occurrence is a field-name entry in a test fixture, not a read). This function's own
	// comment conceded "State / Account_Status are currently unused on live Accounts (all
	// null)". Live population was 75/372.
	//
	// Under the owner's retention rule -- a possible future use is not enough -- both fail the
	// test. An earlier plan draft proposed classifying a Deal-less Account as "Prospect"; that
	// is WITHDRAWN, because it would have added new behaviour to a field with no proven consumer.
	//
	// The writes go first, ahead of the field deletion, because that ordering is mandatory: an
	// api_name that no longer exists can void the ENTIRE updateRecord map. Writers out ->
	// publish -> read the whole map back -> then delete, after P10.
	//
	// ⚠ The COMPUTATION above is retained deliberately. total / lost / signed still drive the
	// Deal-side roll-up this function performs, and acctState / acctStatus remain useful in the
	// log line below -- which is now the only place the classification surfaces. Canary
	// assertion C14 was rewritten for exactly this reason: it can no longer prove roll-up
	// execution via Accounts.Account_Status, so it proves it through retained authoritative
	// outputs instead.
	upd = Map();
	updResp = null;
	if(upd.size() > 0) { updResp = zoho.crm.updateRecord("Accounts", accId.toLong(), upd, noTrigger); }
	// No fields are written any more, so there is nothing to confirm. Treated as OK so the
	// existing log/branching below keeps its shape rather than reporting a false failure.
	updOk = true;
	if(!isNull(updResp)) { updOk = (!isNull(updResp.get("id"))); }
	if(updOk)
	{
		automation.logAutomationEvent("rollupAccountState", "Accounts", accId, "rollup", "applied", {"state":acctState, "account_status":acctStatus, "total":total.toString(), "lost":lost.toString(), "signed":signed.toString()});
	}
	else
	{
		automation.logAutomationEvent("rollupAccountState", "Accounts", accId, "rollup", "update_rejected", {"state":acctState, "account_status":acctStatus, "resp":ifnull(updResp, "").toString()});
	}
}
