void automation.processContact(string contact_id)
{
	// =========================================================================
	// processContact  (Contact-centric)
	//
	// Owns Contact normalization + activation. Does NOT own reconciliation/rollup
	// (that is processDeal, the sole owner — called once at the end).
	//
	// Pipeline:
	//   1. Read Contact, resolve / repair canonical Account (Account_Key)
	//   2. Normalize Contact Stage / State defaults, Contact_Role1 from Job_Title,
	//      and stage-completion dates on the Contact
	//   3. Resolve the Account's SINGLE Deal (resolveOrCreateAccountDeal) and associate this
	//      Contact to it via the Contact_Roles junction, carrying its Contact_Role1 when it
	//      HAS one (blank stays blank). Products are Quotes under that Deal, resolved by
	//      processDeal -- this function no longer resolves Product evidence at all.
	//   4. (reconciliation lives only in processDeal, called once for that Deal)
	//   5. Activation: ensure every unactivated OPEN Contact -- not only Decision Makers --
	//      has exactly one Sequence Activation Task. Several Products under the Deal do NOT
	//      make the sequence ambiguous; [multi_product_sequence_ambiguous] is retired.
	//
	// Product resolution outcomes (HARD RULE 4 / 7):
	//   - 0 products -> MQL-level. No Deal, no [product_unresolved], no activation.
	//   - each resolved product -> its own Product Deal (Deal_Key=accountKey::productKey).
	//   - unresolved raw evidence -> Manual Review [product_unresolved].
	//   - >1 Product Deal for one Contact -> activation deferred to Manual Review.
	//
	// All processor writes use suppressTrigger so WFC-Contact / WFC-Deal /
	// WFC-Account do not cascade.
	//
	// REQUIRED ZOHO CRM SETTING:
	// - Accounts.Account_Key UNIQUE
	// - Deals.Deal_Key UNIQUE
	// =========================================================================
	info "VERSION: v6-contact-centric-product-deal";

	if(contact_id == null || contact_id == "") { return; }
	cleanId = contact_id.replaceAll("zcrm_", "").trim();

	contactRecord = zoho.crm.getRecordById("Contacts", cleanId.toLong());
	if(contactRecord.get("id") == null) { return; }

	stageRanks = {"Marketing Consent":1, "Demo Booking":2, "Demo Confirmation":3, "Demo Hosted":4, "Proposal Preparation":5, "Commercial Agreement":6, "Onboarding":7, "Renewal":8};

	// ---- 1. Read Contact ----
	accountId = "";
	accNameMap = contactRecord.get("Account_Name");
	if(accNameMap != null && accNameMap.get("id") != null)
	{
		accountId = accNameMap.get("id").toString();
	}
	email = ifnull(contactRecord.get("Email"), "").toString().trim();
	cName = ifnull(contactRecord.get("Full_Name"), "").toString().trim();
	if(cName == "")
	{
		first = ifnull(contactRecord.get("First_Name"), "").toString().trim();
		last = ifnull(contactRecord.get("Last_Name"), "").toString().trim();
		cName = (first + " " + last).trim();
	}

	accountKey = "";

	// ======================================================================================
	// ---- 2. Resolve / repair canonical Account ----
	//
	// WORK ITEM 4.7a. This replaced TWO of the four competing Account_Key precedences that
	// lived here: the Account-exists branch (Website -> Email domain -> Account_Name) and the
	// no-Account branch (Email domain -> Company, with NO Website step). That missing Website
	// step was the concrete divergence -- the same company keyed one way when a Contact arrived
	// with an Account and another way when it arrived without one, forking into two Accounts.
	//
	// Both branches now go through the single authority, and the no-Account branch additionally
	// gets K5/K6: it searches EVERY key form the evidence supports, not just the one its own
	// precedence derives, so a Contact at x@acme.com finds the Account already keyed "acme ltd"
	// instead of creating a second one keyed "acme.com".
	// ======================================================================================
	if(accountId != "")
	{
		// K2: a Contact already associated with an Account ALWAYS inherits that Account's key.
		// No derivation is attempted while a key exists (K1 -- existing keys are immutable).
		accRec = zoho.crm.getRecordById("Accounts", accountId.toLong());
		accountKey = ifnull(accRec.get("Account_Key"), "").toString();
		accountName = ifnull(accRec.get("Account_Name"), "").toString().trim();

		if(accountKey == "")
		{
			// K3: derive ONCE for an Account that has never been keyed, from the richest evidence
			// available at this moment -- which here includes the Contact's email, evidence the
			// Account record itself cannot carry.
			accountKey = automation.deriveAccountKey(ifnull(accRec.get("Website"), "").toString(), email, accountName, contact_id);
			zoho.crm.updateRecord("Accounts", accountId.toLong(), {"Account_Key": accountKey}, {"trigger": List()});
			// K6: read the key back. SUCCESS proves nothing -- an off-layout field discards the
			// write silently while the rest of the map commits.
			pcKeyBack = "";
			pcAccReread = zoho.crm.getRecordById("Accounts", accountId.toLong());
			if(!isNull(pcAccReread) && !isNull(pcAccReread.get("id"))) { pcKeyBack = ifnull(pcAccReread.get("Account_Key"), "").toString().trim(); }
			if(pcKeyBack != accountKey)
			{
				automation.createManualReview(cleanId, "", "account_key_ambiguous", "Account " + accountId + ": the Account_Key write did not read back (wrote '" + accountKey + "', read '" + pcKeyBack + "'). No Deal was resolved against an unverified key.");
				automation.logAutomationEvent("processContact", "Accounts", accountId, "account_key", "readback_mismatch", {"wrote":accountKey, "read":pcKeyBack});
				return;
			}
		}
	}
	else
	{
		// No Account link. K5: search ALL evidence forms before creating anything.
		pcAccRaw = automation.resolveAccount("", email, cName, contact_id);
		pcAcc = Map();
		if(!isNull(pcAccRaw) && pcAccRaw.toString().trim() != "") { pcAcc = pcAccRaw.toString().toMap(); }
		pcStatus = ifnull(pcAcc.get("status"), "error").toString();

		if(pcStatus == "one")
		{
			// K4: reuse the Account and its immutable key. Any better-looking key this record's
			// own evidence would derive is discarded -- stable beats forking.
			accountId = ifnull(pcAcc.get("account_id"), "").toString();
			accountKey = ifnull(pcAcc.get("account_key"), "").toString();
		}
		else if(pcStatus == "none")
		{
			// K6 zero: the valid new-company case. Create exactly ONE Account, persist its key,
			// and read BOTH back before anything depends on them.
			accountKey = ifnull(pcAcc.get("derived_key"), "").toString();
			createAccMap = Map();
			createAccMap.put("Account_Key", accountKey);
			createAccMap.put("Account_Name", if(cName != "", cName, accountKey));

			accCreateRes = zoho.crm.createRecord("Accounts", createAccMap);
			if(!isNull(accCreateRes) && accCreateRes.get("id") != null)
			{
				accountId = accCreateRes.get("id").toString();
			}
			else if(!isNull(accCreateRes) && accCreateRes.get("code") == "DUPLICATE_DATA" && accCreateRes.get("details") != null)
			{
				accountId = accCreateRes.get("details").get("id").toString();
			}

			if(accountId == "" || accountId == "null")
			{
				automation.logAutomationEvent("processContact", "Contacts", cleanId, "account_resolution", "account_create_failed", {"derived_key":accountKey});
				return;
			}
			// Read the Account AND its key back.
			pcNewBack = zoho.crm.getRecordById("Accounts", accountId.toLong());
			pcNewKey = "";
			if(!isNull(pcNewBack) && !isNull(pcNewBack.get("id"))) { pcNewKey = ifnull(pcNewBack.get("Account_Key"), "").toString().trim(); }
			if(pcNewKey == "")
			{
				automation.createManualReview(cleanId, "", "account_key_ambiguous", "Account " + accountId + " was created but its Account_Key did not read back (expected '" + accountKey + "'). No Deal was resolved against an unverified key.");
				automation.logAutomationEvent("processContact", "Accounts", accountId, "account_key", "created_readback_blank", {"expected":accountKey});
				return;
			}
			accountKey = pcNewKey;
		}
		else if(pcStatus == "many")
		{
			// K6 more than one: STOP. Name every candidate, make NO dependent write, and never
			// merge, re-key, Lose or delete a duplicate Account automatically.
			automation.createManualReview(cleanId, "", "account_key_ambiguous", "This Contact's evidence matches MORE THAN ONE Account (" + ifnull(pcAcc.get("candidates"), "").toString() + "). Nothing was linked, no Account was created and no Deal was resolved. Consolidate the Accounts by hand; automation will never merge or re-key them.");
			automation.logAutomationEvent("processContact", "Contacts", cleanId, "account_resolution", "multiple_accounts", {"candidates":ifnull(pcAcc.get("candidates"), "").toString()});
			return;
		}
		else
		{
			// The lookup itself failed. Do NOT fall through and create -- that is how a company
			// that already has an Account acquires a second one.
			automation.logAutomationEvent("processContact", "Contacts", cleanId, "account_resolution", "resolve_failed", {"reason":ifnull(pcAcc.get("reason"), "").toString()});
			return;
		}
	}

	if(accountId == "" || accountId == "null") { return; }

	// accountName must be defined on BOTH account paths (the else-branch that creates a
	// new Account never set it). Fall back to the Contact name then the Account_Key so
	// resolveOrCreateAccountDeal always receives a non-empty display name.
	if(isNull(accountName) || accountName.toString().trim() == "")
	{
		accountName = if(cName != "", cName, accountKey);
	}

	// ---- 3. Normalize Contact defaults and completed dates ----
	updConInit = Map();
	if(accNameMap == null || accNameMap.get("id") == null || accNameMap.get("id").toString() != accountId)
	{
		updConInit.put("Account_Name", accountId);
	}
	contactStage = ifnull(contactRecord.get("Stage"), "").toString().trim();
	if(contactStage == "")
	{
		contactStage = "Marketing Consent";
		updConInit.put("Stage", contactStage);
	}
	if(ifnull(contactRecord.get("State"), "") == "") { updConInit.put("State", "Open"); }
	if(ifnull(contactRecord.get("Status"), "") == "") { updConInit.put("Status", "New"); }

	// Resolve and populate custom Contact_Role field if empty (inlined — no cross-function call)
	// Defaults above and the role below ONLY fill blanks — never overwrite an explicit value.
	//
	// RAW-TITLE FALLBACK (2026-08-09), matching processLead and processDeal. Only ~154 of
	// the 415 governed persona titles are live Job_Title picklist values, so the booking
	// backend writes the rest (and any "Other" free text) to Job_Title_Raw alone. Without
	// this, a Contact reached on the reuse path — a returning visitor, whose Contact is
	// updated directly and never converted — could never resolve a role, and so could
	// never reach the activation gate below.
	//
	// The default differs by path, deliberately: an unmatched PICKLIST title keeps
	// "Decision Maker" (a curated value with a missing map entry is a curation gap), an
	// unmatched RAW title resolves to nothing rather than guessing on free text.
	cJobTitle = ifnull(contactRecord.get("Job_Title"), "").toString().trim();
	cJobTitleRaw = ifnull(contactRecord.get("Job_Title_Raw"), "").toString().trim();
	if((cJobTitle != "" || cJobTitleRaw != "") && ifnull(contactRecord.get("Contact_Role1"), "").toString().trim() == "")
	{
		// WORK ITEM 4.7: one title->role authority; blank stays blank (was seeded
		// "Decision Maker" whenever a governed Job_Title was present).
		titleKey = if(cJobTitle != "", cJobTitle.toLowerCase(), cJobTitleRaw.toLowerCase());
		resolvedRoleVal = automation.roleForTitle(cJobTitle, cJobTitleRaw);
		if(resolvedRoleVal != "")
		{
			info "processContact: resolved Contact_Role title='" + titleKey + "' → role='" + resolvedRoleVal + "'";
			updConInit.put("Contact_Role1", resolvedRoleVal);
		}
		else
		{
			info "processContact: Contact_Role unresolved for raw title='" + titleKey + "' — left blank for manual triage";
		}
	}

	// Stage completion date dynamic stamping on Contact itself
	contactStageFields = Map();
	contactStageFields.put("Marketing Consent", "Contact_Completed_Marketing_Qualification_At");
	contactStageFields.put("Demo Booking", "Contact_Completed_Demo_Booking_At");
	contactStageFields.put("Demo Confirmation", "Contact_Completed_Demo_Confirmation_At");
	contactStageFields.put("Demo Hosted", "Contact_Completed_Demo_Hosted_At");
	contactStageFields.put("Proposal Preparation", "Contact_Completed_Proposal_Preparation_At");
	contactStageFields.put("Commercial Agreement", "Contact_Completed_Commercial_Agreement_At");
	contactStageFields.put("Onboarding", "Contact_Completed_Onboarding_At");
	contactStageFields.put("Renewal", "Contact_Completed_Renewal_At");

	// ======================================================================================
	// WORK ITEM 4.8a -- the stage-entry timestamp writer, corrected (rules W1-W7).
	//
	// The eight Contact_Completed_*_At fields are the AUTHORITATIVE ledger of when each Contact
	// ENTERED the corresponding Stage. All eight are KEEP -- for automation, historical
	// bookkeeping, reporting AND leading-Contact selection (criterion 4 of the 4.8a ordering).
	//
	// ⚠ Semantic note, deliberate: the api_names say "Completed"; the owner-defined fact is Stage
	// ENTRY. A LABEL-only rename to "Contact Entered [Stage] At" may be proposed. Do NOT change
	// the api_names and do NOT create replacement fields -- in particular there is no
	// Contacts.Stage_Entered_At, and an earlier suggestion of one is withdrawn.
	//
	// WHAT WAS WRONG (W1). The loop removed here stamped EVERY field whose rank was <=
	// contactRank. On a Contact arriving at, say, Commercial Agreement it back-filled Marketing
	// Consent, Demo Booking, Demo Confirmation, Demo Hosted and Proposal Preparation ALL AT THE
	// SAME INSTANT -- fabricating a progression that never happened. Live measurement: 644 of 647
	// Contacts carry every populated stamp at an identical timestamp, clustered inside the
	// 2026-07-21 import loop.
	//
	// ⚠ That measurement is evidence of THIS DEFECTIVE WRITER. It is not evidence that the fields
	// are unnecessary, and must not be read that way.
	//
	// HOW ENTRY IS DETECTED, without a signature change. processContact is bound to WF001b0 and
	// WF001b2 with a single argument, so a `stageEnteredNow` parameter would require reconfiguring
	// both rules and would break the binding on publish. Entry is instead derived from the record
	// itself: the field for the Contact's CURRENT Stage being blank IS the observation that this
	// Stage has just been entered and never stamped. That single test satisfies every rule:
	//
	//   W1  no bulk-stamp loop -- one field, never a range
	//   W2  a reconcile pass over an unchanged Contact finds the field already populated and
	//       writes nothing, so reconciliation cannot fabricate history
	//   W3  only the newly entered Stage is written
	//   W4  write once -- the `== null` test never overwrites
	//   W5  imported values are preserved for the same reason: a value present is a historical
	//       fact that outranks anything this pass could compute
	//   W6  see the 12:00 note below for date-only sources
	//   W7  earlier Stages a Contact never occupied under automation stay BLANK, and a blank
	//       correctly does not rank at ordering criterion 4
	//
	// The one behaviour this cannot reconstruct is a Stage the Contact passed through before the
	// corrected writer shipped. That is intentional: blank means "not known", which is honest,
	// whereas the old loop's answer was confident and wrong.
	// ======================================================================================
	contactRank = ifnull(stageRanks.get(contactStage), 1).toLong();
	entryFieldApi = contactStageFields.get(contactStage);
	if(entryFieldApi != null && contactRecord.get(entryFieldApi) == null)
	{
		// Store local CRM time without an explicit timezone. XXX stored one hour behind in BST;
		// literal Z stored one hour ahead; raw DateTime was ignored.
		//
		// W6: this path always knows the time, because it is witnessing the entry as it happens.
		// The 12:00 neutral default applies to IMPORT, where only a date is known -- see the
		// import mapping in processLead, which is the only writer that carries a date-only source.
		updConInit.put(entryFieldApi, zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ss"));
		automation.logAutomationEvent("processContact", "Contacts", cleanId, "stage_entry_stamped", contactStage, {"field":entryFieldApi});
	}

	if(updConInit.size() > 0)
	{
		// Suppress Contact workflow to prevent processContact recursing on its own write.
		suppressTrigger = Map();
		suppressTrigger.put("trigger", List());
		updConInitResp = zoho.crm.updateRecord("Contacts", cleanId.toLong(), updConInit, suppressTrigger);
		info "Contact update resp (incl. Contact_Role if blank, trigger suppressed): " + updConInitResp;
		contactRecord = zoho.crm.getRecordById("Contacts", cleanId.toLong());
	}

	// ======================================================================================
	// ---- 4. Resolve the Account's ONE Deal ----
	//
	// WORK ITEM 4.3. This replaces the Product-Deal fan-out: a normalizeToProductQuoteTuples
	// call, a loop creating one Deal PER PRODUCT via createOrReuseProductDeal, per-product
	// Contact_Roles association, a pipelineForProductKey split into b2bDriverDealIds /
	// partnerDriverDealIds, a processDeal call per Product Deal, and the HARD RULE 7
	// [multi_product_sequence_ambiguous] guard.
	//
	// Under the approved ontology a Product is a QUOTE under the Account's one Deal, so:
	//   - there is exactly one Deal to resolve, not one per product
	//   - Products no longer need resolving HERE at all. processDeal owns Quote upsert and
	//     reads the same evidence through the same adapter, so resolving it twice only created
	//     a second opinion.
	//   - "several Products" STOPS being ambiguity. The plan is explicit: several Products or
	//     Quotes under a Deal do NOT make a Contact's sequence ambiguous, because cadence is
	//     Contact-scoped. [multi_product_sequence_ambiguous] is retired.
	//   - the B2B/Partnership driver split goes with it. Pipeline is a property of the one Deal
	//     (Deals.Pipeline, work item 3.1), not something a Product elects, and dispatch
	//     suppression is the standing gate in routeContactSequence.
	//
	// The Contact_Roles association is PRESERVED -- it is Contact-to-Deal membership, which the
	// model still needs -- but it now happens once, against the one Deal.
	// ======================================================================================

	// Resolve the Contact_Role value once, for the Contact_Roles junction.
	// WORK ITEM 4.7: blank STAYS blank. This used to default to "Decision Maker", which
	// manufactured decision-making authority for every Contact whose title did not resolve --
	// and that default then outranked real Influencers in the leading-Contact ordering.
	contactRoleVal = ifnull(contactRecord.get("Contact_Role1"), "").toString().trim();

	dealRes = automation.resolveOrCreateAccountDeal(accountId, accountKey, accountName, "");
	dealResMap = Map();
	if(!isNull(dealRes) && dealRes.toString().trim() != "") { dealResMap = dealRes.toString().toMap(); }

	if(ifnull(dealResMap.get("valid"), "false").toString() != "true")
	{
		dealResReason = ifnull(dealResMap.get("reason"), "unknown").toString();
		dealResCands = ifnull(dealResMap.get("candidates"), "").toString();
		if(dealResReason == "multiple_deals_for_account" || dealResReason == "duplicate_deal_key_after_insert")
		{
			automation.createManualReview(cleanId, "", "multiple_deals_for_account", "This Contact's Account resolves to MORE THAN ONE Deal (" + dealResCands + "). Under the approved model an Account holds at most one persistent Deal, so this is a concurrency defect. Nothing was linked or activated. Consolidate by hand; never merge or re-key automatically.");
		}
		else
		{
			automation.createManualReview(cleanId, "", "product_unresolved", "Could not resolve or create the Account's Deal (" + dealResReason + "). The Contact was not linked and no sequence was activated.");
		}
		automation.logAutomationEvent("processContact", "Contacts", cleanId, "account_deal_unresolved", dealResReason, {"account":accountId, "candidates":dealResCands});
		return;
	}

	accountDealId = ifnull(dealResMap.get("deal_id"), "").toString();
	if(accountDealId == "" || !accountDealId.matches("[0-9]+"))
	{
		automation.logAutomationEvent("processContact", "Contacts", cleanId, "account_deal_unresolved", "blank_deal_id", {"account":accountId});
		return;
	}

	// Associate this Contact to the Account's Deal, carrying its resolved role when it HAS one.
	roleMap = Map();
	if(contactRoleVal != "") { roleMap.put("Contact_Role", contactRoleVal); }
	zoho.crm.updateRelatedRecord("Contact_Roles", cleanId.toLong(), "Deals", accountDealId.toLong(), roleMap);

	// processDeal = sole owner of Contacts, Roles, Products, leading Contact, Quote upsert,
	// Opportunity_* roll-up and the Account roll-up. It resolves Product evidence itself.
	automation.processDeal(accountDealId, "{}");

	automation.logAutomationEvent("processContact", "Contacts", cleanId, "account_deal", ifnull(dealResMap.get("reason"), "").toString(), {"deal":accountDealId, "account":accountId});

	// ---- 5. Activation, driven by the Account's Deal. ----
	// Re-read the Contact for authoritative State / Sequence_State / role (processDeal
	// may have touched Contact_Role1 / Primary Contact).
	contactRecord = zoho.crm.getRecordById("Contacts", cleanId.toLong());
	contactSeqState = ifnull(contactRecord.get("Sequence_State"), "").toString();
	if(contactSeqState == "")
	{
		// blank lifecycle -> explicitly Not Activated (so the gate below is unambiguous)
		zoho.crm.updateRecord("Contacts", cleanId.toLong(), {"Sequence_State": "Not Activated"}, {"trigger": List()});
		contactSeqState = "Not Activated";
	}

	// ---- Activation gate: EVERY ELIGIBLE Contact, Open + Not Activated ----
	//
	// ⚠ WORK ITEM 4.3 / canary assertion C4. The role test (HARD RULE 6, "Decision Maker only")
	// is REMOVED. Opportunity authority lives on the Contact, and every eligible Contact is its
	// own opportunity -- so every eligible Contact receives exactly one Activation Task, not
	// only the Decision Makers. C4 asserts this directly.
	//
	// Combined with 4.7 ("blank stays blank"), keeping the test would have been worse than
	// before: with the "Decision Maker" default gone, a Contact whose title does not resolve now
	// holds a BLANK role, so a Decision-Maker-only gate would have silently excluded every one
	// of them from activation instead of accidentally including them.
	//
	// Eligibility is now exactly what it says: viable (State Open) and not already in a
	// sequence. A Stopped / Running / Complete Contact must never auto-(re)activate here.
	contactState = ifnull(contactRecord.get("State"), "Open").toString();
	if(contactState == "Open" && contactSeqState == "Not Activated")
	{
		// ⚠ CHANGE 18 and HARD RULE 7 are both REMOVED.
		//
		// CHANGE 18 chose a "driver" Deal: B2B drivers won whenever they existed, Partnership
		// drivers were consulted only if none did. HARD RULE 7 then raised
		// [multi_product_sequence_ambiguous] whenever more than one driver survived.
		//
		// Neither has anything to decide any more. There is ONE Deal per Account, so there is no
		// driver election, and several Products under it do not make the Contact's sequence
		// ambiguous -- cadence is Contact-scoped. Pipeline suppression is the standing gate in
		// routeContactSequence (Change 20), which reads Deals.Pipeline; a Partnership Contact
		// still gets its canonical Activation Task and stores its preference here, and still
		// dispatches nothing.
		dealId = accountDealId;
		// ---- CHANGE 1: canonical Activation Task identity ----------------------------------
		// The identity is Who_Id (Contact) + Task_Type = "Sequence Activation", and NOTHING else.
		// Task_Sequence_Stage, What_Id/$se_module and native Status remain useful context but
		// stop being identity, so a Stage move or a second Deal can no longer hide an existing
		// Task from dedupe and produce a duplicate control.
		//
		// Retrieval must therefore be CONTACT-scoped. The Deal-scoped read this replaced could
		// not see a Task hosted on a different Deal. getRelatedRecords("Tasks","Contacts",..) is
		// a proven relation name in this org - see createManualReview.deluge:55.
		//
		//   candidates       = every Activation Task for this Contact
		//   activeCandidates = candidates where Status != "Deferred"      (the control set)
		//
		// Completed Tasks stay valid controls (that is the normal state of a committed
		// Activation Task); Deferred Tasks are RETIRED and retirement is final.
		actReadOk = true;
		actTasks = zoho.crm.getRelatedRecords("Tasks", "Contacts", cleanId.toLong());
		if(isNull(actTasks) || actTasks.size() == 0 || actTasks.toString().startsWith("{\"code\""))
		{
			actTasks = zoho.crm.searchRecords("Tasks", "(Who_Id:equals:" + cleanId + ")");
		}
		if(isNull(actTasks))
		{
			actReadOk = false;
			actTasks = List();
		}
		else if(actTasks.toString().startsWith("{\"code\""))
		{
			// NO_CONTENT means "genuinely no rows"; anything else is an UNRESOLVED read.
			// HARD RULE (plan 11.11): an unreadable related list is NEVER read as "empty", or
			// Change 1 would create the very duplicate it exists to prevent.
			if(actTasks.toString().contains("NO_CONTENT")) { actReadOk = true; }
			else { actReadOk = false; }
			actTasks = List();
		}

		actCandidates = List();      // ids, identity = Who_Id + Task_Type
		actActive = List();          // ids, the control set
		actActiveBlank = List();     // ids of active candidates that are indistinguishable-concurrent-create
		actDetail = Map();           // id -> "state/type" for the ambiguity review
		for each atk in actTasks
		{
			aWho = "";
			aWhoL = atk.get("Who_Id");
			if(!isNull(aWhoL) && !isNull(aWhoL.get("id"))) { aWho = aWhoL.get("id").toString(); }
			if(aWho != cleanId) { continue; }
			if(ifnull(atk.get("Task_Type"), "").toString() != "Sequence Activation") { continue; }
			aId = atk.get("id").toString();
			actCandidates.add(aId);
			if(ifnull(atk.get("Status"), "").toString() == "Deferred") { continue; }
			actActive.add(aId);
			aState = ifnull(atk.get("Task_State"), "").toString().trim();
			aTStatus = ifnull(atk.get("Task_Status"), "").toString().trim();
			aType = ifnull(atk.get("Task_Sequence_Type"), "").toString().trim();
			if(aType == "-None-") { aType = ""; }
			aDesc = ifnull(atk.get("Description"), "").toString();
			actDetail.put(aId, aState + "/" + aType);
			// The four-part indistinguishability test - exactly the shape two racing
			// processContact runs produce: neither sets Task_Sequence_Type, and neither has been
			// through handleTaskCompletion, so neither carries a marker.
			if(aState == "Open" && aTStatus == "New" && aType == "" && !aDesc.contains("ActivationCommand|"))
			{
				actActiveBlank.add(aId);
			}
		}

		if(!actReadOk)
		{
			// Fail safe: skip creation and log. Never treat an unresolved read as "none exist".
			automation.logAutomationEvent("processContact", "Contacts", cleanId, "activation", "activation_task_read_unresolved", {"deal":dealId});
			return;
		}

		// ---- the collapse rule: one rule, used identically at all three sites --------------
		if(actActive.size() > 1)
		{
			if(actActiveBlank.size() == actActive.size())
			{
				// Every active candidate is indistinguishable -> keep the lowest id, retire the
				// rest. Retired siblings LEAVE the active set, so the collapse is operationally
				// final: the next execution sees exactly one active control.
				collKeep = 999999999999999999;
				for each cId2 in actActive
				{
					if(cId2.toLong() < collKeep) { collKeep = cId2.toLong(); }
				}
				for each cId3 in actActive
				{
					if(cId3.toLong() != collKeep)
					{
						// 5.1: Blocks_Sequence dropped from this map (RETIRE, zero readers). Status=Deferred
						// alone retires the duplicate, and the isBlockingTask derivation already treats a
						// Deferred Task as non-blocking.
						zoho.crm.updateRecord("Tasks", cId3.toLong(), {"Status":"Deferred"}, {"trigger": List()});
						automation.logAutomationEvent("processContact", "Tasks", cId3, "activation_dedupe", "deferred_duplicate", {"contact":cleanId, "kept":collKeep.toString()});
					}
				}
			}
			else
			{
				// STOP SAFELY. Defer nothing, change nothing. Anointing whichever Task happened to
				// be found is precisely the arbitrary choice the rule forbids.
				ambDetail = "";
				for each cId4 in actActive
				{
					ambDetail = ambDetail + " " + cId4 + "(" + ifnull(actDetail.get(cId4), "").toString() + ")";
				}
				automation.createManualReview(cleanId, dealId, "activation_control_ambiguous", "Several active Sequence Activation Tasks exist for this Contact and they are not provably indistinguishable, so automation will not choose between them. Candidates (id, Task_State/Task_Sequence_Type):" + ambDetail + ". Retire the ones that are not the intended control (native Status = Deferred), leaving exactly one.");
				return;
			}
		}
		else if(actActive.size() == 0 && actCandidates.size() > 0)
		{
			// The Contact's control was retired and none replaced it. That is a data condition
			// for a human, not something to paper over with a fresh Task.
			automation.createManualReview(cleanId, dealId, "activation_no_active_control", "Every Sequence Activation Task for this Contact is retired (native Status = Deferred) and no active control remains. Automation will not create a replacement. Reinstate the intended Task or confirm the Contact should have no activation control.");
			return;
		}

		// Any Activation Task - open, completed, at any Stage, on any Deal - means one already
		// exists. Because the predicate WIDENS, this can only reduce Task creation, never
		// increase it.
		activationExists = (actActive.size() > 0);

		if(!activationExists)
		{
			// The Activation Task is the human decision point. Task_Sequence_Type is the
			// only command field; Contact.Sequence_Type stays blank until the owner chooses.
			// Lead_Source is context only and must not preselect or infer the route.
			ownerId = "";
			ownerLookup = contactRecord.get("Owner");
			if(!isNull(ownerLookup) && !isNull(ownerLookup.get("id"))) { ownerId = ownerLookup.get("id").toString(); }
			leadSrc = ifnull(contactRecord.get("Lead_Source"), "").toString();
			// Route is chosen by the rep on the Activation Task via Task_Sequence_Type. The Task is
			// ALWAYS created with Task_Sequence_Type blank so the rep explicitly selects Email/Call/Manual;
			// the Contact's residual Sequence_Type must never auto-activate a route.
			// Real newline for rep-facing Description text (this org's Deluge stores a literal
			// backslash-n instead of a line break). hextoText("0A") = line feed (a raw newline in a string literal is not valid Deluge here).
			nl = hextoText("0A");
			actDesc = "Purpose" + nl + "Complete this task to activate the Contact's sequence." + nl + nl + "Contact: " + cName + nl + "Stage: " + contactStage + nl + "Lead Source (context only): " + leadSrc + nl + nl + "What you need to update" + nl + "1. Select the appropriate Task Sequence Type:" + nl + "   - Email = automation sends the opening email, then books the first Call" + nl + "   - Call = automation books the first Call" + nl + "   - Manual = you run the sequence yourself (automated emails/calls stay off)" + nl + "2. To choose a different opening email (Email route), add a Note to this Task containing only 'Warm' or 'Cold'." + nl + "3. Leave the Task without a Warm or Cold Note to use the standard opening email." + nl + "4. Set Task State = Won to start." + nl + nl + "Do not edit" + nl + "Description, Task Pipeline, Task Stage, sequence-management fields, or automation status fields." + nl + "Do not change the task's Status field — automation closes it for you." + nl + nl + "Important" + nl + "- The most recently added Note controls the opening-email variant." + nl + "- That Note must contain only 'Warm' or 'Cold' - any other content uses the standard opening email." + nl + "- Do not enter both 'Warm' and 'Cold' (that stops activation and creates a Manual Review)." + nl + "- Only the first email changes; the rest of the sequence continues normally.";
			actTask = Map();
			actTask.put("Subject", "Activate sequence: " + cName + " — " + contactStage);
			actTask.put("Status", "Not Started");
			actTask.put("What_Id", dealId);
			actTask.put("$se_module", "Deals");
			actTask.put("Who_Id", cleanId);
			actTask.put("Task_Sequence_Managed", true);
			actTask.put("Task_Type", "Sequence Activation");
			actTask.put("Task_Sequence_Stage", contactStage);
			// 5.1: Blocks_Sequence writer removed. RETIRE, zero readers -- blocking is COMPUTED
	// from Task_Sequence_Managed / Task_Type / Status / Task_Status (the isBlockingTask
	// derivation), so the persisted field added nothing. Writers must go BEFORE the field is
	// deleted: reading a deleted api_name voids the whole map, taking valid keys with it.
			actTask.put("Description", actDesc);
			// F4 FIX (2026-06-24): the activation Task must carry the full inherited commercial
			// context (parity with email-audit / aux Tasks), not only the sequence stage and not
			// only in Subject/Description text. Task_Stage = commercial stage (= contactStage, kept
			// in sync with Deal.Opportunity_Stage); Task_Opportunity = Deal.Stage (opportunity type);
			// Task_Pipeline via the shared resolver (Deluge getRecordById omits Pipeline).
			actTask.put("Task_Stage", contactStage);
			actTask.put("Task_State", "Open");
			actTask.put("Task_Status", "New");
			// WORK ITEM 3.2 -- Task_Opportunity is the CONTACT's MQL/SQL/FTP/RTP, derived from
			// the Contact's own Stage through the single authority. It used to read Deals.Stage,
			// which is the Deal's roll-up: every Activation Task on a multi-Contact Deal recorded
			// the same opportunity type no matter where each Contact actually was. The Deal read
			// that existed only to fetch it is removed with it.
			actOppType = automation.opportunityForContactStage(contactStage);
			if(actOppType != "") { actTask.put("Task_Opportunity", actOppType); }
			actPipeline = automation.resolveDealPipeline(dealId.toString());
			// 3.1: "unresolved" must not be stamped into the picklist.
			if(actPipeline != "" && actPipeline != "unresolved") { actTask.put("Task_Pipeline", actPipeline); }
			if(ownerId != "") { actTask.put("Owner", ownerId); }
			actResp = zoho.crm.createRecord("Tasks", actTask);
			info "processContact: created Sequence Activation Task resp=" + actResp;
		}

		// ---- 6b. The self-heal that used to live here is now the CHANGE 1 collapse rule above.
		//          It runs BEFORE creation rather than after it, evaluates the same Contact-scoped
		//          activeCandidates set the runtime and the offline remediation use, and refuses
		//          to collapse anything that is not provably indistinguishable. A Deferred Task is
		//          skipped by handleTaskCompletion (Status=Deferred -> return), so a retired
		//          duplicate never activates; the write is suppressed so WF008 does not re-fire.
	}
}
