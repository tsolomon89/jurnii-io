void automation.processAccount(string account_id)
{
	// =========================================================================
	// processAccount  (Account-Deal centric, thin)
	//
	// ONE ACCOUNT -> ZERO OR ONE PERSISTENT DEAL, keyed Deal_Key == Account_Key with no
	// "::" suffix. A Product enters the model as a QUOTE under that one Deal, never as
	// another Deal. processAccount only:
	//   1. Ensures Account_Key is stamped on the Account, through the single 4.7a
	//      authority, and READS IT BACK (processDeal requires it).
	//   2. Resolves the Account's one Deal via automation.resolveOrCreateAccountDeal,
	//      creating it only when none exists. MORE THAN ONE stops with a review naming
	//      every candidate and writes nothing.
	//   3. Runs automation.processDeal(dealId, "{}") for that Deal.
	//   4. Rolls up Account state via automation.rollupAccountState(cleanId).
	//
	// ⚠ The per-product grouping, duplicate-silencing and product fan-out this function
	// used to perform are GONE (work item 4.3). In particular it no longer silences a
	// second Deal by writing Opportunity_State=Lost and blanking Deal_Key: under the
	// corrected model a second Deal under one Account is a concurrency defect, and 4.2's
	// K6 contract forbids merging, re-keying or Losing one automatically -- a silent merge
	// would hide exactly the defect that needs to be seen. That is a deliberate reduction
	// in automation.
	//
	// All internal writes use trigger suppression so WFC-Account / WFC-Deal do not
	// cascade. resolveOrCreateAccountDeal creates WITHOUT trigger suppression by design
	// (idempotent; processDeal is also called explicitly below).
	//
	// REQUIRED ZOHO CRM SETTING:
	// - Accounts.Account_Key UNIQUE
	// - Deals.Deal_Key UNIQUE  (declared but NOT enforced live -- see K6)
	// =========================================================================
	info "VERSION: v6-product-deal";

	if(account_id == null || account_id == "") { return; }
	cleanId = account_id.replaceAll("zcrm_", "").trim();
	if(!cleanId.matches("[0-9]+"))
	{
		automation.logAutomationEvent("processAccount", "Accounts", cleanId, "guard", "invalid_account_id_argument", {"raw":account_id});
		return;
	}

	noTrigger = Map();
	noTrigger.put("trigger", List());

	accountRecord = zoho.crm.getRecordById("Accounts", cleanId.toLong());
	if(isNull(accountRecord) || accountRecord.get("id") == null) { return; }

	// ---- 1. Ensure Account_Key ----
	// WORK ITEM 4.7a. The derivation was one of FOUR competing precedences; it now delegates to
	// the single authority. This site's own precedence was Website -> Account_Name -> unknown::,
	// with no email step -- structurally forced, because Accounts carry no Email field. Passing
	// "" for the email argument preserves that exactly while using the shared algorithm.
	//
	// K1: the `if(accountKey == "")` guard was already correct and is now binding everywhere -- an
	// existing non-blank key is authoritative and immutable, never recomputed, never "upgraded"
	// because better evidence appeared later.
	accountKey = ifnull(accountRecord.get("Account_Key"), "").toString();
	accountName = ifnull(accountRecord.get("Account_Name"), "").toString().trim();
	if(accountKey == "")
	{
		accountKey = automation.deriveAccountKey(ifnull(accountRecord.get("Website"), "").toString(), "", accountName, cleanId);
		zoho.crm.updateRecord("Accounts", cleanId.toLong(), {"Account_Key": accountKey}, noTrigger);
		// K3/K6: persist once, then READ BACK. A successful API response proves nothing -- an
		// off-layout field discards the write silently and the rest of the map still commits.
		accKeyBack = "";
		accReread = zoho.crm.getRecordById("Accounts", cleanId.toLong());
		if(!isNull(accReread) && !isNull(accReread.get("id"))) { accKeyBack = ifnull(accReread.get("Account_Key"), "").toString().trim(); }
		if(accKeyBack != accountKey)
		{
			automation.logAutomationEvent("processAccount", "Accounts", cleanId, "account_key", "readback_mismatch", {"wrote":accountKey, "read":accKeyBack});
			automation.createManualReview("", cleanId, "account_key_ambiguous", "Account " + cleanId + ": the Account_Key write did not read back (wrote '" + accountKey + "', read '" + accKeyBack + "'). No Deal was resolved or created against an unverified key. Check that Account_Key is on the Account layout.");
			return;
		}
	}

	// accountName fallback so it is always defined for downstream helpers.
	if(accountName == "") { accountName = accountKey; }

	// ======================================================================================
	// ---- 2. Resolve the Account's ONE Deal ----
	//
	// WORK ITEM 4.3. This replaces ~145 lines that grouped the Account's related Deals BY
	// Deal_Product_Key, elected a lowest-id canonical per product, silenced same-product
	// duplicates as [duplicate_product_deal], derived the Account's product set from
	// normalizeToProductQuoteTuples, and then created one Deal PER PRODUCT not already covered.
	//
	// All of it was the "Deal = Account x Product" model. Under the approved ontology:
	//
	//     one Account -> ZERO OR ONE persistent Deal
	//     a Product enters as a QUOTE under that one Deal, never as another Deal
	//
	// so there is no product set to fan out over, no per-product canonical to elect, and
	// [duplicate_product_deal] describes a condition that can no longer arise -- it is one of
	// the three review codes retired with this correction.
	//
	// ⚠ What is deliberately NOT preserved: the duplicate-silencing pass. It wrote
	// Opportunity_State=Lost, blanked Deal_Key and appended "(Duplicate)" to the name of any
	// live Deal sharing a product key. Under the corrected model a second Deal under one Account
	// is a CONCURRENCY DEFECT, and 4.2's K6 contract is explicit that it must never be merged,
	// re-keyed or Lost automatically -- a silent merge hides exactly the defect that needs
	// seeing. The resolver returns "many", this raises a review naming every candidate, and a
	// human consolidates. That is a deliberate reduction in automation.
	//
	// Product evidence is still collected -- by processDeal, which owns Quote upsert. This
	// function no longer needs it, so the normalizeToProductQuoteTuples call goes too.
	// ======================================================================================
	dealIdsToProcess = List();

	accDealRaw = automation.resolveOrCreateAccountDeal(cleanId, accountKey, accountName, "");
	accDeal = Map();
	if(!isNull(accDealRaw) && accDealRaw.toString().trim() != "") { accDeal = accDealRaw.toString().toMap(); }

	if(ifnull(accDeal.get("valid"), "false").toString() == "true")
	{
		accDealId = ifnull(accDeal.get("deal_id"), "").toString();
		if(accDealId != "" && accDealId.matches("[0-9]+")) { dealIdsToProcess.add(accDealId); }
		automation.logAutomationEvent("processAccount", "Deals", accDealId, "account_deal", ifnull(accDeal.get("reason"), "").toString(), {"account":cleanId, "deal_key":accountKey});
	}
	else
	{
		accDealReason = ifnull(accDeal.get("reason"), "unknown").toString();
		accDealCands = ifnull(accDeal.get("candidates"), "").toString();
		if(accDealReason == "multiple_deals_for_account" || accDealReason == "duplicate_deal_key_after_insert")
		{
			// K6 "more than one". Stop, name every candidate, write nothing to any of them.
			automation.createManualReview("", cleanId, "multiple_deals_for_account", "Account " + cleanId + " resolves to MORE THAN ONE Deal (" + accDealCands + "). Under the approved model an Account holds at most one persistent Deal, so this is a concurrency defect, not a data variant. Nothing was reconciled and no Deal was written. Consolidate by hand: decide which Deal survives, move its Quotes, and never merge or re-key automatically.");
		}
		else
		{
			automation.createManualReview("", cleanId, "product_unresolved", "Account " + cleanId + " has no resolvable Deal (" + accDealReason + "). Nothing was reconciled.");
		}
		automation.logAutomationEvent("processAccount", "Accounts", cleanId, "account_deal_unresolved", accDealReason, {"candidates":accDealCands});
	}

	// ---- 3. Reconcile the Account's Deal ----
	// A list of one, kept as a list so the loop, the id guard and the "reconcile nothing when
	// unresolved" behaviour all stay exactly as they were.
	for each dealId in dealIdsToProcess
	{
		if(dealId != "" && dealId.matches("[0-9]+"))
		{
			pdRes = automation.processDeal(dealId, "{}");
		}
	}

	// ---- 4. Roll up Account state ----
	automation.rollupAccountState(cleanId);
}
