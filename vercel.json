{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["lhr1"],
  "functions": {
    "api/v1/submissions/[id].js": { "maxDuration": 60 },
    "api/v1/bookings/index.js": { "maxDuration": 60 },
    "api/v1/bookings/[id]/index.js": { "maxDuration": 30 },
    "api/v1/bookings/[id]/reschedule.js": { "maxDuration": 30 },
    "api/v1/bookings/[id]/status.js": { "maxDuration": 30 },
    "api/v1/internal/jobs/run.js": { "maxDuration": 60 },
    "api/v1/internal/jobs/retention.js": { "maxDuration": 60 },
    "api/v1/internal/journeys/[id]/resolve.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/jobs/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/internal/jobs/retention",
      "schedule": "15 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin-form",
      "destination": "/admin-form.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
