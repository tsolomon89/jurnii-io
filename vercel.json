{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.(?:css|js|woff2|woff|ttf|png|jpg|jpeg|svg|ico|pdf|json)).*)",
      "destination": "/index.html"
    }
  ]
}
