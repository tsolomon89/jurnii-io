{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/v1/submissions/[id].js": { "maxDuration": 60 },
    "api/v1/bookings/index.js": { "maxDuration": 30 },
    "api/v1/bookings/[id]/reschedule.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
