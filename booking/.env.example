# Jurnii booking integration — environment variables (names only; set real values in Vercel).
# Copy to .env for local `vercel dev`. NEVER commit real secrets.

# --- Continuation token signing ---
JWT_SECRET=

# --- Zoho CRM (EU datacenter) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# CRM API base; default https://www.zohoapis.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
# OAuth accounts host; default accounts.zoho.eu
ZOHO_ACCOUNTS_HOST=accounts.zoho.eu
# Lead_Source picklist value written on Page 1. Must be a valid Leads.Lead_Source
# option ('Website' exists live; 'Website Booking Form' does NOT). Default 'Website'.
ZOHO_LEAD_SOURCE=Website
# Identity is resolved Contact-first (existing Contact → update in place; else an
# unconverted Lead; else create a Lead). There is NO custom submission module. The
# correlation key is a client-generated journey UUID (journeyId), carried in the
# JWT and stored in the standard Events field Ext_Calendar_Booking_ID.

# --- CRM linkage (KISS) ---
# Page 2 does ONE required save and advances immediately (no conversion/Deal polling).
# At booking, the website takes one snapshot: it links the Zoho Meeting to the resolved
# person (Contact, else Lead) and to the exact open Product Deal ONLY if it already
# exists (else person-linked; the booking still confirms). The website never creates an
# Account/Deal/Quote and never invokes processLead/processContact — so there is NO
# reconciliation URL, no Functions REST scope, and no OAuth re-authorization here.

# --- Google Calendar ---
# The refresh token must be consented for BOTH scopes:
#   https://www.googleapis.com/auth/calendar.events            (events insert/patch/get/list + Meet)
#   https://www.googleapis.com/auth/calendar.events.freebusy   (freebusy.query)
# Re-authorize only if the existing token lacks a FreeBusy grant.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Host calendar id (a shared/host mailbox); default 'primary'
GOOGLE_CALENDAR_ID=
# Host working-hours timezone; default Europe/London
HOST_TIMEZONE=Europe/London

# --- Optional: attribution destinations (only set once the fields exist + are approved in Zoho).
# When set, Page-1 writes the values to these Lead field API names; otherwise attribution is logged only.
ZOHO_LEAD_FIELD_SOURCE_PAGE=
ZOHO_LEAD_FIELD_UTM_SOURCE=
ZOHO_LEAD_FIELD_UTM_MEDIUM=
ZOHO_LEAD_FIELD_UTM_CAMPAIGN=

# --- Optional: dedicated Zoho Event field API name to store the Google Meet URL (else Description only).
ZOHO_EVENT_MEET_FIELD=

# --- Job title: the raw free-text title is written to this Lead text field (created live on
# Leads + Contacts), NEVER the governed Job_Title picklist (which would be polluted). A Deluge
# mapping populates the canonical Job_Title picklist + Contact role from Job_Title_Raw.
ZOHO_LEAD_JOBTITLE_RAW_FIELD=Job_Title_Raw

# --- Public site base URL, used to build the self-service manage/cancel link returned by
# POST /bookings and embedded in the calendar invite. Falls back to the request host, else jurnii.io.
PUBLIC_BASE_URL=https://jurnii.io

# --- Optional: extra email domains to block at intake (comma-separated), on top of the built-in
# free/personal/disposable list. Work-email-only is enforced server-side in /submissions/start.
BLOCKED_EMAIL_DOMAINS=

# --- Optional: comma-separated allowed browser origins (reserved for cross-origin hosting).
ALLOWED_ORIGINS=https://jurnii.io
