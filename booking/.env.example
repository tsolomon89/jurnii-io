# Jurnii booking integration — environment variables (names only; set real values in Vercel).
# Copy to .env.local for local development. NEVER commit real secrets.
#
# ============================================================================
# ZOHO METADATA BOUNDARY — applies to every variable below.
#
# This backend NEVER creates or alters a Zoho module, field, layout, picklist
# value, workflow, validation rule, blueprint, OAuth scope or connection. The
# integration surface has no function capable of it and a test asserts each such
# name is absent. Where a variable names a Zoho field, that field must ALREADY
# EXIST: a missing field, picklist value or scope is a PREREQUISITE FAILURE to
# report, never permission to repair the metadata. The same applies to Deluge —
# nothing here publishes or edits a function.
# ============================================================================

# --- Database (Neon) --------------------------------------------------------
# Pooled: every request-path read and every transaction.
DATABASE_URL=
# Unpooled: migrations only — pg_advisory_lock is session-scoped and cannot work
# over PgBouncer transaction pooling.
DATABASE_URL_UNPOOLED=

# --- Token signing ----------------------------------------------------------
# Signs flow tokens (2h) and manage tokens (30d). Rotating it invalidates every
# live session AND every emailed manage link.
JWT_SECRET=

# --- Calendar identity (§4.3) ----------------------------------------------
# GOOGLE_CALENDAR_ID must be an EXPLICIT address. 'primary' and any value without
# an '@' are rejected at boot and by register-calendar: an alias and its address
# denote the same calendar, so accepting both would split one calendar into two
# reservation namespaces and let two journeys hold the same slot.
GOOGLE_CALENDAR_ID=
# An arbitrary internal label, 1:1 with the address above and DIFFERENT per
# environment (jurnii_local / jurnii_preview / jurnii_prod). Must match
# ^[a-z0-9_]{4,32}$. Not a secret. Survives the PII scrub as the analytics
# "which calendar" key, which is why it is a configured label rather than a hash
# of the address — a hash of a mailbox drawn from a handful of candidates is
# reversible by enumeration, i.e. pseudonymous rather than anonymous.
BOOKING_CALENDAR_KEY=
# SECRET. Keys the booking_calendars fingerprint. Rotating it invalidates every
# stored fingerprint: clear the row and re-run register-calendar in the same
# change window, or R2 fails closed with 503 calendar_misconfigured.
BOOKING_CALENDAR_HMAC_KEY=

# --- Operator resolution (§4.10) -------------------------------------------
# SECRET. Gates POST /internal/journeys/{id}/resolve and nothing else. Deliberately
# separate from CRON_SECRET and rejected by the job endpoints. It can change a
# booking's truth, so treat it like a production database password.
# It keys NOTHING, so it is freely rotatable.
BOOKING_ADMIN_SECRET=
# SECRET. Keys the resolution request fingerprint — deliberately NOT the admin
# bearer, so rotating that credential cannot invalidate historical replays.
RESOLUTION_FINGERPRINT_HMAC_KEY=
# Stable identifier recorded on every resolution row, DIFFERENT per environment
# (local-v1 / preview-v1 / production-v1). Not a secret.
RESOLUTION_FINGERPRINT_HMAC_KEY_ID=
# Optional previous generation, so one generation of history stays replayable
# across a fingerprint-key rotation. Set BOTH or neither.
RESOLUTION_FINGERPRINT_HMAC_KEY_PREVIOUS=
RESOLUTION_FINGERPRINT_HMAC_KEY_PREVIOUS_ID=
# Lease and reclaim bounds for the fenced resolution protocol.
RESOLUTION_LEASE_SECONDS=120
RESOLUTION_MAX_ATTEMPTS=3

# --- Cron / worker ----------------------------------------------------------
# SECRET. Gates the job endpoints. BOOKING_ADMIN_SECRET is explicitly rejected there.
CRON_SECRET=
JOBS_BATCH_LIMIT=20
JOBS_TIME_BUDGET_MS=40000
# Crash-reclaim ceiling. A row reaching it is TERMINATED inside the claim
# transaction — before any handler or external call runs.
JOBS_MAX_CRASH_RECLAIMS=3

# --- Google recovery windows ------------------------------------------------
# The uncertainty window for an armed create. At the deadline: a 404 plus a
# confirmed writer/owner access probe commits G3 (booking_failed); anything else
# commits T1 (needs_attention) with the hold RETAINED.
GOOGLE_UNCERTAINTY_WINDOW_MINUTES=30
# The durable watch phase for an unreadable reschedule.
GOOGLE_WATCH_MAX_HOURS=24
GOOGLE_WATCH_CADENCE_MINUTES=60
# The deadline extension applied by RT1.resume — same attempt, same candidate id.
GOOGLE_RESUME_WINDOW_MINUTES=30

# --- Zoho windows -----------------------------------------------------------
# Conversion discovery runs on BOTH the accepted and uncertain paths, read-only.
CONVERSION_DISCOVERY_WINDOW_MINUTES=60
# Uncertain-create recovery: searches repeat, and a single empty result is never
# sufficient because indexing lags.
ZOHO_CREATE_INDEX_GRACE_MINUTES=15
ZOHO_CREATE_RECOVERY_WINDOW_MINUTES=60
ZOHO_REQUEST_TIMEOUT_MS=12000

# --- Reservations and slots -------------------------------------------------
RESERVATION_TTL_MINUTES=10
# Overridable only for tests, where a lowered notice makes the buffered
# hold_end_utc boundary observable.
MIN_NOTICE_MS=86400000
BOOKING_HORIZON_MS=5184000000

# --- Retention (§9) ---------------------------------------------------------
# Destructive execution gate. FALSE (or absent) means EVERY retention invocation
# is a dry run — candidates are reported, nothing is scrubbed or purged — even
# though the cron path passes no ?dryRun flag. Set TRUE only to deliberately arm
# real scrubbing; ?dryRun=1 still forces dry-run even when armed. Production
# starts FALSE.
RETENTION_EXECUTION_ENABLED=false
RETENTION_PAGE1_DAYS=90
RETENTION_PAGE2_DAYS=180
RETENTION_BOOKED_DAYS=365
RETENTION_PURGE_DAYS=730
# One extension per outstanding review episode. After it lapses a journey scrubs
# on its normal lifecycle date EVEN IF the issue was never resolved, so nothing
# blocks retention forever.
RETENTION_REVIEW_EXTENSION_DAYS=90
# Optional pseudonymous analytics. Default false.
ANALYTICS_RETAIN_EMAIL_HASH=false
EMAIL_HASH_SALT=

# --- Cancellation (§7.2) ----------------------------------------------------
# FALSE in Production. The durable infrastructure ships in full; only the
# visitor-facing DELETE is gated, because the closest available CRM
# representation routes to a "thanks for attending" cadence for a demo that never
# happened. Enabling it requires the separately approved Deluge correction —
# which is a metadata change and out of scope for this backend.
BOOKING_CANCELLATION_ENABLED=false
# Shown on the manage page while cancellation is gated, and on the
# needs-attention panel.
BOOKING_SUPPORT_EMAIL=

# --- Zoho CRM (EU datacenter) ----------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.eu
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.eu
# Must be an EXISTING Leads.Lead_Source option ('Website' exists live;
# 'Website Booking Form' does NOT).
ZOHO_LEAD_SOURCE=Website
# The user id owning unlinked (ambiguous-identity) Manual Review Tasks.
ZOHO_MANUAL_REVIEW_OWNER_ID=
# The raw free-text job title is written to this EXISTING text field, NEVER the
# governed Job_Title picklist, which a free-text value would pollute.
ZOHO_LEAD_JOBTITLE_RAW_FIELD=Job_Title_Raw
# Optional EXISTING Event field for the Meet URL; otherwise it goes in Description.
ZOHO_EVENT_MEET_FIELD=

# --- Google Calendar --------------------------------------------------------
# The refresh token must be consented for BOTH scopes:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.events.freebusy
# Whether the current token carries them is a PREREQUISITE to verify, not an
# assumption. A scope change is a console action for the project owner.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
HOST_TIMEZONE=Europe/London

# --- Site ------------------------------------------------------------------
# Used to build the manage URL embedded in the calendar invite. Falls back to the
# request host, then jurnii.io.
PUBLIC_BASE_URL=https://jurnii.io
# Extra blocked email domains, on top of the built-in free/disposable list.
BLOCKED_EMAIL_DOMAINS=

# --- Frontend (browser globals, NOT env vars) --------------------------------
# The widget is a static file, so it cannot read this file. These are set on the
# host page before booking-form.js loads. All are optional; the defaults are safe.
#
#   JURNII_BOOKING_EMBEDDED = true
#       The host page owns the modal chrome. The widget then paints no close
#       button and never wires its own CTA interception. assets/site.jsx sets it
#       BEFORE injecting the script; render(el, {onClose}) also implies it.
#
#   JURNII_BOOKING_CANCELLATION_ENABLED = true
#       Mirrors BOOKING_CANCELLATION_ENABLED above and MUST be kept in step with
#       it. Default false, i.e. the cancel button is hidden. Fail-safe by design:
#       a misconfiguration hides a button that would only answer 403, rather than
#       offering one that always fails. Leave it unset in Production.
#
#   JURNII_BOOKING_SUPPORT_EMAIL
#       Mirrors BOOKING_SUPPORT_EMAIL for the manage page's cancellation fallback
#       and the needs-attention panel. Defaults to hello@jurnii.io.
#
#   JURNII_BOOKING_API_BASE      default /api/v1
#   JURNII_BOOKING_CONFIG_URL    default /booking/config/countries.js
#       Only needed when the module is mounted somewhere other than /booking.

# --- Removed ---------------------------------------------------------------
# ZOHO_ACCOUNTS_HOST            -> replaced by ZOHO_ACCOUNTS_DOMAIN (full URL)
# ZOHO_LEAD_FIELD_SOURCE_PAGE   -> attribution is persisted in Postgres, not Zoho
# ZOHO_LEAD_FIELD_UTM_*         -> same; no Zoho field is required or created
