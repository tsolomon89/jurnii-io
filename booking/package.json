    "verify:prereq": "node scripts/verify-prerequisites.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/functions": "^3.7.6",
    "googleapis": "^140.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
