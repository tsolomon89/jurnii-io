# Lemlist -> Zoho CRM outbound-activity import.
#
# Copy the names you need into the host environment; NEVER put a real secret in
# this file. Production values are pulled with:
#   vercel env pull --environment=production .env.production.local
#
# Every flag is FAIL-SAFE: absent, empty, or anything other than the exact string
# `true` means the safe/off direction. A freshly provisioned environment
# therefore imports nothing — the daily cron runs and does no work — until an
# operator deliberately arms each gate in turn.
#
# There is NO database configuration here, because there is no database. The
# Zoho Task Subject is the import identity and the overlapping window is the
# retry; between them they remove the need for any local state.

# --- Credentials -------------------------------------------------------------
# ⚠ HIGH-CONSEQUENCE SECRET. The same key can send real LinkedIn messages
# through POST /inbox/linkedin. The client in lemlist.js is non-mutating by
# construction — no generic mutation method exists and the send paths do not
# appear in its source — but the key itself is as sensitive as a mailbox
# password. It is also refused by the test guard, so it can never be present
# while tests run.
LEMLIST_API_KEY=replace-me

# Zoho credentials are REUSED from the host environment unchanged:
#   ZOHO_ACCOUNTS_DOMAIN, ZOHO_API_DOMAIN, ZOHO_CLIENT_ID,
#   ZOHO_CLIENT_SECRET, ZOHO_REFRESH_TOKEN
# Required scopes (a missing one is a prerequisite to REPORT, never to widen):
#   ZohoCRM.coql.READ
#   ZohoCRM.modules.tasks.CREATE  ZohoCRM.modules.tasks.READ
#   ZohoCRM.modules.contacts.CREATE  ZohoCRM.modules.contacts.READ
#   ZohoCRM.modules.accounts.CREATE  ZohoCRM.modules.accounts.READ
#   ZohoCRM.users.READ   (optional: without it, sender mapping falls back to
#                         LEMLIST_DEFAULT_OWNER_ID rather than failing)
# CRON_SECRET is reused unchanged and is the ONLY credential the endpoint
# accepts. BOOKING_ADMIN_SECRET is explicitly rejected and the rejection logged.

# --- Gates, in the order they should be armed --------------------------------
# 1. Nothing at all happens without this. Arm it first and inspect a dry run.
LEMLIST_SYNC_ENABLED=false
# 2. Until this is `true` every invocation is a FULL DRY RUN: activities are
#    fetched, identities resolved and payloads built, but no Zoho write occurs.
#    `?dryRun=1` on the request forces a dry run regardless and can never be
#    overridden by configuration.
LEMLIST_ZOHO_WRITE_ENABLED=false
# 3. Contact and Account creation, gated separately from Task writes because it
#    is the only operation whose mistakes tomorrow's run does not fix. Deals and
#    Quotes are never created under any configuration.
LEMLIST_ALLOW_RECORD_CREATION=false
# 4. Message-body retrieval from GET /inbox/{contactId}. Off costs one line of
#    the Description; it never blocks a Task.
LEMLIST_BODY_LOOKUP_ENABLED=false

# --- Window ------------------------------------------------------------------
# The deliberately overlapping lookback, and therefore the retry depth. A run
# always asks for the last N days rather than "everything since last time", so a
# failed Sunday is covered by Monday, Tuesday and every run after it. Widening
# this costs requests and nothing else, because re-importing is impossible.
LEMLIST_LOOKBACK_DAYS=7

# The Lemlist activity type to import. A SINGLE CONSTANT on purpose: the value
# `linkedinSent` appears in Lemlist's spec as a webhook event, a lead state and a
# stats counter, but is not enumerated for GET /activities — so if the spike
# shows a different value, this is the only thing that changes. Results are also
# filtered client-side against this exact value (an allow-list of one), so a
# server-side filter that is silently ignored cannot admit linkedinVisitDone,
# linkedinInviteFailed, linkedinSendFailed and the rest as "sends".
LEMLIST_ACTIVITY_TYPE=linkedinSent

# --- Bounds ------------------------------------------------------------------
# Blast-radius bound for rollout: 5 -> 25 -> 100 -> unset, verifying at each step.
LEMLIST_MAX_TASKS_PER_RUN=5
# The Zoho user id that owns Tasks whose Lemlist sender cannot be mapped, and
# owns records this integration creates. Without it, `Owner` is simply omitted
# and Zoho defaults to the API user — an arbitrary user is never chosen.
LEMLIST_DEFAULT_OWNER_ID=

# --- Tuning (defaults are fine) ----------------------------------------------
# Lemlist allows 20 requests per 2 seconds per key, globally. Requests are
# strictly serial, so one interval gate is enough. 150ms is ~6.7 rps against a
# ~10 rps ceiling: deliberately under, because guessing high costs a 429 and
# guessing low costs nothing.
LEMLIST_MIN_REQUEST_INTERVAL_MS=150
LEMLIST_MAX_RETRIES=3
LEMLIST_REQUEST_TIMEOUT_MS=15000
# Characters of message body kept in the Task Description. Truncation announces
# itself in the text rather than happening silently.
LEMLIST_BODY_MAX_CHARS=4000
