# Jurnii booking integration — environment variables (names only; set real values in Vercel).
# Copy to .env for local `vercel dev`. NEVER commit real secrets.

# --- Continuation token signing ---
JWT_SECRET=

# --- Zoho CRM (EU datacenter) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# CRM API base; default https://www.zohoapis.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
# OAuth accounts host; default accounts.zoho.eu
ZOHO_ACCOUNTS_HOST=accounts.zoho.eu
# Custom progressive-state module API name; default Website_Submissions
ZOHO_SUBMISSION_MODULE=Website_Submissions

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Host calendar id (a shared/host mailbox); default 'primary'
GOOGLE_CALENDAR_ID=
# Host working-hours timezone; default Europe/London
HOST_TIMEZONE=Europe/London

# --- Optional: attribution destinations (only set once the fields exist + are approved in Zoho).
# When set, Page-1 writes the values to these Lead field API names; otherwise attribution is logged only.
ZOHO_LEAD_FIELD_SOURCE_PAGE=
ZOHO_LEAD_FIELD_UTM_SOURCE=
ZOHO_LEAD_FIELD_UTM_MEDIUM=
ZOHO_LEAD_FIELD_UTM_CAMPAIGN=

# --- Optional: dedicated Zoho Event field API name to store the Google Meet URL (else Description only).
ZOHO_EVENT_MEET_FIELD=

# --- Optional: comma-separated allowed browser origins (reserved for cross-origin hosting).
ALLOWED_ORIGINS=https://jurnii.io
