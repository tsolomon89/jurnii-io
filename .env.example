# =============================================================================
# Jurnii booking backend — example configuration.
#
# Copy to `.env` (gitignored) and fill in. NEVER put a real secret in this file.
# Production values are pulled with:
#   vercel env pull --environment=production .env.production.local
#
# Every flag below is FAIL-SAFE: absent, empty or anything other than the exact
# string `true` means the safe/off direction, so a freshly provisioned
# environment does nothing dangerous until an operator deliberately arms it.
# =============================================================================

# --- Feature gates -----------------------------------------------------------

# Visitor-initiated cancellation. Off in Production: the Deluge cancellation
# contract is not approved, so a visitor DELETE answers 403 with no Google or
# Zoho call. The manage page has a matching host-page global; move BOTH together.
BOOKING_CANCELLATION_ENABLED=false

# Retention EXECUTION. Off means every retention invocation is a dry run that
# reports candidates and mutates nothing. The scrub/purge sweep is irreversible.
RETENTION_EXECUTION_ENABLED=false

# Whether a confirmed booking's Zoho Meeting may ACTIVATE the commercial
# automation. Off = "Meeting-only mode": the Meeting is still created, correlated
# and linked to the final Contact and Deal, but every write is `trigger: []`, so
# WF007 (handleMeetingEvent) never sees it and no stage advance, reminder field
# or sequence email follows. The journey still reaches integration-complete, with
# zoho_meeting_activation_state = 'suppressed'. That is a normal outcome, not a
# failure, and it raises no Manual Review.
BOOKING_MEETING_AUTOMATION_ENABLED=false

# --- Database ----------------------------------------------------------------
# Pooled for the app; unpooled for migrations (pg_advisory_lock needs a session).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# --- Public surface ----------------------------------------------------------
PUBLIC_BASE_URL=https://example.vercel.app
HOST_TIMEZONE=Europe/London
BOOKING_SUPPORT_EMAIL=hello@example.com

# --- Calendar ----------------------------------------------------------------
# A real calendar id, never `primary` and never an alias: two ids for one calendar
# split the reservation namespace. Must match the registered booking_calendars row.
GOOGLE_CALENDAR_ID=c_xxxxxxxxxxxxxxxx@group.calendar.google.com
BOOKING_CALENDAR_KEY=jurnii_local
# A DISPOSABLE calendar for verify-prerequisites.js. MUST NOT equal
# GOOGLE_CALENDAR_ID — the script refuses if it does.
VERIFY_CALENDAR_ID=c_yyyyyyyyyyyyyyyy@group.calendar.google.com

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me

# --- Zoho --------------------------------------------------------------------
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
ZOHO_CLIENT_ID=replace-me
ZOHO_CLIENT_SECRET=replace-me
ZOHO_REFRESH_TOKEN=replace-me
ZOHO_LEAD_SOURCE=Website
ZOHO_LEAD_JOBTITLE_RAW_FIELD=Job_Title_Raw
ZOHO_MANUAL_REVIEW_OWNER_ID=

# --- Secrets (generate independently PER ENVIRONMENT; never reuse) -----------
# CRON_SECRET drives the job endpoints; BOOKING_ADMIN_SECRET can change a
# booking's truth. They are deliberately not interchangeable.
JWT_SECRET=generate-me
CRON_SECRET=generate-me
BOOKING_ADMIN_SECRET=generate-me
BOOKING_CALENDAR_HMAC_KEY=generate-me
RESOLUTION_FINGERPRINT_HMAC_KEY=generate-me
RESOLUTION_FINGERPRINT_HMAC_KEY_ID=local-v1
