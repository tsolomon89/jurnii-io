# =============================================================================
# Jurnii booking backend — example configuration.
#
# Copy to `.env` (gitignored) and fill in. NEVER put a real secret in this file.
# Production values are pulled with:
#   vercel env pull --environment=production .env.production.local
#
# Every flag below is FAIL-SAFE: absent, empty or anything other than the exact
# string `true` means the safe/off direction, so a freshly provisioned
# environment does nothing dangerous until an operator deliberately arms it.
# =============================================================================

# --- Feature gates -----------------------------------------------------------

# Visitor-initiated cancellation. Off in Production: the Deluge cancellation
# contract is not approved, so a visitor DELETE answers 403 with no Google or
# Zoho call. The manage page has a matching host-page global; move BOTH together.
BOOKING_CANCELLATION_ENABLED=false

# Retention EXECUTION. Off means every retention invocation is a dry run that
# reports candidates and mutates nothing. The scrub/purge sweep is irreversible.
RETENTION_EXECUTION_ENABLED=false

# Whether a confirmed booking's Zoho Meeting may ACTIVATE the commercial
# automation. Off = "Meeting-only mode": the Meeting is still created, correlated
# and linked to the final Contact and Deal, but every write is `trigger: []`, so
# WF007 (handleMeetingEvent) never sees it and no stage advance, reminder field
# or sequence email follows. The journey still reaches integration-complete, with
# zoho_meeting_activation_state = 'suppressed'. That is a normal outcome, not a
# failure, and it raises no Manual Review.
BOOKING_MEETING_AUTOMATION_ENABLED=false

# Whether a committed write immediately wakes a background drain for that journey,
# instead of waiting for the next scheduled worker pass. Must be exactly `true`;
# absent/empty/anything else is disabled, the fail-safe direction.
#
# It is a HINT, never a delivery: Postgres remains the authority on what work
# exists, so a lost dispatch costs latency and nothing else — the operation stays
# `pending` and the scheduled sweep claims it. Unsetting this is the instant
# rollback, with no deploy required.
BOOKING_DISPATCH_ENABLED=false

# --- Database ----------------------------------------------------------------
# Pooled for the app; unpooled for migrations (pg_advisory_lock needs a session).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# --- Public surface ----------------------------------------------------------
PUBLIC_BASE_URL=https://example.vercel.app
HOST_TIMEZONE=Europe/London
BOOKING_SUPPORT_EMAIL=hello@example.com

# --- Host calendars -----------------------------------------------------------
# Three booking hosts, two variables each. See booking/.env.example for the full
# rationale; the short version:
#
#   · a real calendar id, never `primary` and never an alias — two ids for one
#     calendar split the reservation namespace;
#   · CALENDAR_KEY is the internal reservation namespace, ^[a-z0-9_]{4,32}$,
#     distinct per environment AND per host (convention: <host>_<env>);
#   · each must be registered with `npm run register-calendar` before that
#     environment accepts bookings.
#
# Which host the public website books. Explicit — never inferred from ordering,
# from `primary`, or from the OAuth account. Changing it is this one value.
BOOKING_PUBLIC_HOST=fraser
BOOKING_HOST_FRASER_CALENDAR_ID=fraser@example.com
BOOKING_HOST_FRASER_CALENDAR_KEY=fraser_local
# Marlon is PENDING a Calendar ID. Blank is safe: he renders disabled on the
# internal form, the server refuses him, and the other hosts are unaffected.
BOOKING_HOST_MARLON_CALENDAR_ID=
BOOKING_HOST_MARLON_CALENDAR_KEY=marlon_local
BOOKING_HOST_TIMOTHY_CALENDAR_ID=timothy@example.com
BOOKING_HOST_TIMOTHY_CALENDAR_KEY=timothy_local
# A DISPOSABLE calendar for verify-prerequisites.js. MUST NOT equal ANY configured
# host calendar — the script checks set membership and refuses if it matches one.
VERIFY_CALENDAR_ID=c_yyyyyyyyyyyyyyyy@group.calendar.google.com

# ONE OAuth identity for every host calendar. Do NOT add per-host credentials:
# the model is one authorization identity holding writer/owner access on all three.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me

# --- Zoho --------------------------------------------------------------------
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
ZOHO_CLIENT_ID=replace-me
ZOHO_CLIENT_SECRET=replace-me
ZOHO_REFRESH_TOKEN=replace-me
# The DEFAULT for every public booking; must be an EXISTING Leads.Lead_Source option.
# An internal /admin-form booking overrides it per journey (booking_journeys.lead_source),
# validated against booking/config/zoho-picklists.js. See booking/.env.example for the
# five options whose stored value differs from their display label.
ZOHO_LEAD_SOURCE=Website
# The visitor's title always lands here verbatim. The governed `Job_Title` picklist is
# written separately and only on an exact live-metadata match.
ZOHO_LEAD_JOBTITLE_RAW_FIELD=Job_Title_Raw
ZOHO_MANUAL_REVIEW_OWNER_ID=

# --- Lemlist -> Zoho import (integrations/lemlist-zoho) ----------------------
# Daily one-directional import of LinkedIn outbound activity as completed Zoho
# Tasks. Full reference: integrations/lemlist-zoho/.env.example.
#
# ⚠ LEMLIST_API_KEY IS A HIGH-CONSEQUENCE SECRET. The same credential can send
# real LinkedIn messages via POST /inbox/linkedin. The client in this repo is
# non-mutating by construction and cannot reach that endpoint, but treat the key
# with the same care as a mailbox password.
LEMLIST_API_KEY=replace-me
# Every gate below is FAIL-SAFE: absent, empty, or anything other than the exact
# string `true` means off, so the daily cron is an inert no-op until an operator
# deliberately arms it — in that order.
LEMLIST_SYNC_ENABLED=false
LEMLIST_ZOHO_WRITE_ENABLED=false
LEMLIST_ALLOW_RECORD_CREATION=false
LEMLIST_BODY_LOOKUP_ENABLED=false
# The deliberately overlapping window. It IS the retry mechanism: a failed run is
# simply covered by the next one, and the Task Subject stops anything already
# imported from importing twice.
LEMLIST_LOOKBACK_DAYS=7
# Blast-radius bound during rollout. Raise 5 -> 25 -> 100 once verified.
LEMLIST_MAX_TASKS_PER_RUN=5
# The Zoho user id that owns Tasks whose Lemlist sender cannot be mapped, and
# owns records this integration creates. An arbitrary user is never chosen.
LEMLIST_DEFAULT_OWNER_ID=

# --- Secrets (generate independently PER ENVIRONMENT; never reuse) -----------
# CRON_SECRET drives the job endpoints; BOOKING_ADMIN_SECRET can change a
# booking's truth. They are deliberately not interchangeable.
JWT_SECRET=generate-me
CRON_SECRET=generate-me
BOOKING_ADMIN_SECRET=generate-me
BOOKING_CALENDAR_HMAC_KEY=generate-me
RESOLUTION_FINGERPRINT_HMAC_KEY=generate-me
RESOLUTION_FINGERPRINT_HMAC_KEY_ID=local-v1
