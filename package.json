{
  "name": "jurnii-website",
  "description": "Monorepo: marketing website + booking module (booking/) + Zoho CRM Deluge automation (zoho-functions/). Read CLAUDE.md before touching booking/ or zoho-functions/.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/compile-content-manifest.ts && vite build",
    "preview": "vite preview",
    "test": "node --test \"booking/tests/*.test.js\"",
    "test:db": "node --import ./booking/tests/db/_guard.mjs --test \"booking/tests/db/*.test.js\"",
    "patch:html": "node scripts/patch-cwv-html.mjs",
    "lighthouse:ci": "node scripts/lighthouse-ci.mjs",
    "perf:baseline": "node scripts/lighthouse-ci.mjs --baseline"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/functions": "^3.7.6",
    "googleapis": "^140.0.1",
    "gray-matter": "^4.0.3",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.17.0",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "marked-katex-extension": "^5.1.10",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.1.2",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.0.0",
    "tsx": "^4.23.1",
    "turndown": "^7.2.4",
    "vite": "^6.0.7"
  }
}
